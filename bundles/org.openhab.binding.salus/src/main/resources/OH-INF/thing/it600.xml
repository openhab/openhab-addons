<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="salus"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<thing-type id="salus-it600-device">
		<supported-bridge-type-refs>
			<bridge-type-ref id="salus-cloud-bridge"/>
			<bridge-type-ref id="salus-aws-bridge"/>
		</supported-bridge-type-refs>

		<label>IT600 Salus Thermostat</label>
		<description>
			The IT600 Salus Thermostat Device is a component utilized within the Salus IT600 thermostat system. This
			device communicates with the Salus cloud bridge and offers features including reading the current temperature,
			setting the desired temperature, and defining the operation type. The operation of this device depends on a unique
			Data Source Name (DSN) which serves as an identifier in the Salus cloud system.
		</description>
		<semantic-equipment-tag>Thermostat</semantic-equipment-tag>
		<channels>
			<channel id="temperature" typeId="it600-temp-channel"/>
			<channel id="expected-temperature" typeId="it600-expected-temp-channel"/>
			<channel id="work-type" typeId="it600-work-type-channel"/>
			<channel id="running-state" typeId="it600-running-state"/>
			<channel id="cooling-setpoint" typeId="it600-cooling-setpoint"/>
			<channel id="system-mode" typeId="it600-system-mode"/>
			<channel id="keypad-lock" typeId="it600-keypad-lock"/>
			<channel id="allow-local-unlock" typeId="it600-allow-local-unlock"/>
			<channel id="temperature-offset" typeId="it600-temperature-offset"/>
			<channel id="frost-temperature" typeId="it600-frost-temperature"/>
			<channel id="minimum-setpoint" typeId="it600-minimum-setpoint"/>
			<channel id="maximum-setpoint" typeId="it600-maximum-setpoint"/>
			<channel id="valve-protection" typeId="it600-valve-protection"/>
			<channel id="display-off" typeId="it600-display-off"/>
			<channel id="display-unit" typeId="it600-display-unit"/>
			<channel id="clock-format" typeId="it600-clock-format"/>
			<channel id="active-errors" typeId="it600-active-errors"/>
			<channel id="rssi" typeId="it600-rssi"/>
			<channel id="lqi" typeId="it600-lqi"/>
		</channels>
		<properties>
			<property name="thingTypeVersion">2</property>
		</properties>
		<representation-property>dsn</representation-property>
		<config-description>
			<parameter name="dsn" type="text" required="true">
				<label>DSN</label>
				<description>
					Data Source Name (DSN) — This is a unique identifier used to establish a connection with the Salus
					cloud system. It's crucial for the correct operation of the Salus device,
					enabling communication between the device
					and the cloud.
				</description>
			</parameter>
		</config-description>
	</thing-type>

	<channel-type id="it600-temp-channel">
		<item-type>Number:Temperature</item-type>
		<label>Temperature</label>
		<description>Current temperature in room</description>
		<category>Temperature</category>
		<tags>
			<tag>Measurement</tag>
			<tag>Temperature</tag>
		</tags>
		<state min="5" max="35" step="0.5" readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>
	<channel-type id="it600-expected-temp-channel">
		<item-type>Number:Temperature</item-type>
		<label>Expected Temperature</label>
		<description>Sets the desired temperature in room</description>
		<category>Temperature</category>
		<tags>
			<tag>Setpoint</tag>
			<tag>Temperature</tag>
		</tags>
		<state min="5" max="35" step="0.5" pattern="%.1f %unit%"/>
	</channel-type>
	<channel-type id="it600-work-type-channel">
		<item-type>String</item-type>
		<label>Work Type</label>
		<description>Sets the work type for the device.
			OFF — device is turned off
			MANUAL — schedules are turned off, following
			a manual temperature set,
			AUTOMATIC — schedules are turned on, following schedule,
			TEMPORARY_MANUAL — schedules are
			turned on, following manual temperature until next schedule.
		</description>
		<tags>
			<tag>Control</tag>
			<tag>Mode</tag>
		</tags>
		<state>
			<options>
				<option value="OFF">OFF</option>
				<option value="MANUAL">Manual</option>
				<option value="AUTOMATIC">Automatic</option>
				<option value="TEMPORARY_MANUAL">Temporary Manual</option>
			</options>
		</state>
	</channel-type>
	<channel-type id="it600-running-state">
		<item-type>Switch</item-type>
		<label>Running State</label>
		<description>Is the device running</description>
		<tags>
			<tag>Status</tag>
			<tag>Power</tag>
		</tags>
	</channel-type>

	<channel-type id="it600-cooling-setpoint">
		<item-type unitHint="°C">Number:Temperature</item-type>
		<label>Cooling Setpoint</label>
		<description>Requested cooling temperature. Supported only by cooling-capable thermostats.</description>
		<category>Temperature</category>
		<tags>
			<tag>Setpoint</tag>
			<tag>Temperature</tag>
		</tags>
		<state min="5" max="35" step="0.5" pattern="%.1f %unit%"/>
	</channel-type>
	<channel-type id="it600-system-mode">
		<item-type>String</item-type>
		<label>System Mode</label>
		<description>Selects heating, cooling or off independently of the schedule/hold mode.</description>
		<tags>
			<tag>Control</tag>
			<tag>Mode</tag>
		</tags>
		<state>
			<options>
				<option value="HEAT">Heating</option>
				<option value="COOL">Cooling</option>
				<option value="OFF">Off</option>
			</options>
		</state>
	</channel-type>
	<channel-type id="it600-keypad-lock">
		<item-type>Switch</item-type>
		<label>Keypad Lock</label>
		<description>Locks the thermostat keypad when ON.</description>
		<tags>
			<tag>Control</tag>
		</tags>
	</channel-type>
	<channel-type id="it600-allow-local-unlock" advanced="true">
		<item-type>Switch</item-type>
		<label>Allow Local Unlock</label>
		<description>Allows the keypad to be unlocked on the thermostat when ON.</description>
		<tags>
			<tag>Control</tag>
		</tags>
	</channel-type>
	<channel-type id="it600-temperature-offset" advanced="true">
		<item-type unitHint="°C">Number:Temperature</item-type>
		<label>Temperature Offset</label>
		<description>Calibration offset added to the measured room temperature.</description>
		<category>Temperature</category>
		<tags>
			<tag>Setpoint</tag>
			<tag>Temperature</tag>
		</tags>
		<state min="-3" max="3" step="0.5" pattern="%.1f %unit%"/>
	</channel-type>
	<channel-type id="it600-frost-temperature" advanced="true">
		<item-type unitHint="°C">Number:Temperature</item-type>
		<label>Frost Temperature</label>
		<description>Temperature maintained by frost protection.</description>
		<category>Temperature</category>
		<tags>
			<tag>Setpoint</tag>
			<tag>Temperature</tag>
		</tags>
		<state min="5" max="17" step="0.5" pattern="%.1f %unit%"/>
	</channel-type>
	<channel-type id="it600-minimum-setpoint" advanced="true">
		<item-type unitHint="°C">Number:Temperature</item-type>
		<label>Minimum Heating Setpoint</label>
		<description>Lowest allowed heating setpoint.</description>
		<category>Temperature</category>
		<tags>
			<tag>Setpoint</tag>
			<tag>Temperature</tag>
		</tags>
		<state min="5" max="35" step="0.5" pattern="%.1f %unit%"/>
	</channel-type>
	<channel-type id="it600-maximum-setpoint" advanced="true">
		<item-type unitHint="°C">Number:Temperature</item-type>
		<label>Maximum Heating Setpoint</label>
		<description>Highest allowed heating setpoint.</description>
		<category>Temperature</category>
		<tags>
			<tag>Setpoint</tag>
			<tag>Temperature</tag>
		</tags>
		<state min="5" max="35" step="0.5" pattern="%.1f %unit%"/>
	</channel-type>
	<channel-type id="it600-valve-protection" advanced="true">
		<item-type>Switch</item-type>
		<label>Valve Protection</label>
		<description>Enables the thermostat valve-protection function.</description>
		<tags>
			<tag>Control</tag>
		</tags>
	</channel-type>
	<channel-type id="it600-display-off" advanced="true">
		<item-type>Switch</item-type>
		<label>Display Off</label>
		<description>Switches the thermostat display off when ON.</description>
		<tags>
			<tag>Control</tag>
		</tags>
	</channel-type>
	<channel-type id="it600-display-unit" advanced="true">
		<item-type>String</item-type>
		<label>Display Unit</label>
		<description>Temperature unit shown on the physical thermostat.</description>
		<tags>
			<tag>Control</tag>
			<tag>Mode</tag>
		</tags>
		<state>
			<options>
				<option value="CELSIUS">Celsius</option>
				<option value="FAHRENHEIT">Fahrenheit</option>
			</options>
		</state>
	</channel-type>
	<channel-type id="it600-clock-format" advanced="true">
		<item-type>String</item-type>
		<label>Clock Format</label>
		<description>Time format shown on the physical thermostat.</description>
		<tags>
			<tag>Control</tag>
			<tag>Mode</tag>
		</tags>
		<state>
			<options>
				<option value="12H">12 Hour</option>
				<option value="24H">24 Hour</option>
			</options>
		</state>
	</channel-type>
	<channel-type id="it600-active-errors" advanced="true">
		<item-type>String</item-type>
		<label>Active Errors</label>
		<description>Comma-separated reported error codes, or NONE when all reported flags are clear.</description>
		<tags>
			<tag>Alarm</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="it600-rssi" advanced="true">
		<item-type unitHint="dBm">Number:Power</item-type>
		<label>Received Signal Strength</label>
		<description>Signal strength of the last thermostat radio message.</description>
		<tags>
			<tag>Measurement</tag>
		</tags>
		<state readOnly="true" pattern="%.0f %unit%"/>
	</channel-type>
	<channel-type id="it600-lqi" advanced="true">
		<item-type>Number</item-type>
		<label>Link Quality</label>
		<description>Link quality of the last thermostat radio message.</description>
		<tags>
			<tag>Measurement</tag>
		</tags>
		<state min="0" max="255" step="1" readOnly="true" pattern="%d"/>
	</channel-type>
</thing:thing-descriptions>

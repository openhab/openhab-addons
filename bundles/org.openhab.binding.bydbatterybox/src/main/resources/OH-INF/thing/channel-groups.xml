	<channel-group-type id="events">
		<label>Events</label>
		<description>Event logs of the BMU and the towers.</description>
		<channels>
			<channel id="last-event" typeId="status-text">
				<label>Last Event</label>
				<description>Newest entry of the event logs of the BMU and the towers.</description>
			</channel>
			<channel id="last-event-time" typeId="timestamp">
				<label>Last Event Time</label>
				<description>Time of the newest event, corrected by the offset of the battery clock.</description>
			</channel>
			<channel id="event" typeId="event"/>
		</channels>
	</channel-group-type>

	<channel-group-type id="diagnostics">
		<label>Diagnostics</label>
		<channels>
			<channel id="bmu-clock-offset" typeId="clock-offset"/>
			<channel id="last-detail-update" typeId="timestamp">
				<label>Last Cell Update</label>
				<description>Time of the last successful cell measurement.</description>
			</channel>
		</channels>
	</channel-group-type>


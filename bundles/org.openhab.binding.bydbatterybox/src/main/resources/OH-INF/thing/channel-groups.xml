<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="bydbatterybox"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<channel-group-type id="status">
		<label>Status</label>
		<description>System status, read every refresh interval.</description>
		<channels>
			<channel id="state-of-charge" typeId="state-of-charge"/>
			<channel id="state-of-health" typeId="state-of-health"/>
			<channel id="voltage" typeId="voltage">
				<label>Battery Voltage</label>
			</channel>
			<channel id="output-voltage" typeId="voltage">
				<label>Output Voltage</label>
				<description>Voltage behind the main relay.</description>
			</channel>
			<channel id="current" typeId="current"/>
			<channel id="power" typeId="power"/>
			<channel id="max-cell-voltage" typeId="cell-voltage">
				<label>Max Cell Voltage</label>
				<description>Highest cell voltage, 10 mV resolution.</description>
			</channel>
			<channel id="min-cell-voltage" typeId="cell-voltage">
				<label>Min Cell Voltage</label>
				<description>Lowest cell voltage, 10 mV resolution.</description>
			</channel>
			<channel id="cell-voltage-spread" typeId="cell-voltage-calculated">
				<label>Cell Voltage Spread</label>
				<description>Difference between highest and lowest cell voltage, 10 mV resolution. The tower groups provide 1 mV
					resolution.</description>
			</channel>
			<channel id="max-cell-temperature" typeId="temperature">
				<label>Max Cell Temperature</label>
			</channel>
			<channel id="min-cell-temperature" typeId="temperature">
				<label>Min Cell Temperature</label>
			</channel>
			<channel id="bmu-temperature" typeId="temperature">
				<label>BMU Temperature</label>
			</channel>
			<channel id="charged-energy" typeId="energy">
				<label>Charged Energy</label>
				<description>Lifetime charged energy.</description>
			</channel>
			<channel id="discharged-energy" typeId="energy">
				<label>Discharged Energy</label>
				<description>Lifetime discharged energy.</description>
			</channel>
			<channel id="efficiency" typeId="efficiency"/>
			<channel id="usable-capacity" typeId="energy-calculated">
				<label>Usable Capacity</label>
				<description>Nominal capacity reduced by the state of health.</description>
			</channel>
			<channel id="stored-energy" typeId="energy-calculated">
				<label>Stored Energy</label>
				<description>Usable capacity multiplied by the state of charge.</description>
			</channel>
			<channel id="error" typeId="alarm">
				<label>Error</label>
				<description>ON while the battery reports at least one system error.</description>
			</channel>
			<channel id="errors" typeId="status-text">
				<label>Errors</label>
				<description>System errors reported by the battery.</description>
			</channel>
		</channels>
	</channel-group-type>

	<channel-group-type id="tower">
		<label>Tower</label>
		<description>Cell measurement summary of one tower, read every cell detail interval.</description>
		<channels>
			<channel id="state-of-charge" typeId="state-of-charge"/>
			<channel id="state-of-health" typeId="state-of-health"/>
			<channel id="voltage" typeId="voltage">
				<label>Tower Voltage</label>
			</channel>
			<channel id="output-voltage" typeId="voltage">
				<label>Output Voltage</label>
			</channel>
			<channel id="current" typeId="current"/>
			<channel id="charged-energy" typeId="energy">
				<label>Charged Energy</label>
				<description>Lifetime charged energy of the tower.</description>
			</channel>
			<channel id="discharged-energy" typeId="energy">
				<label>Discharged Energy</label>
				<description>Lifetime discharged energy of the tower.</description>
			</channel>
			<channel id="efficiency" typeId="tower-efficiency"/>
			<channel id="usable-capacity" typeId="energy-calculated">
				<label>Usable Capacity</label>
				<description>Nominal capacity of the tower reduced by its state of health.</description>
			</channel>
			<channel id="stored-energy" typeId="energy-calculated">
				<label>Stored Energy</label>
				<description>Usable capacity of the tower multiplied by its state of charge.</description>
			</channel>
			<channel id="max-cell-voltage" typeId="cell-voltage">
				<label>Max Cell Voltage</label>
			</channel>
			<channel id="max-cell-voltage-cell" typeId="cell-number">
				<label>Max Voltage Cell</label>
			</channel>
			<channel id="min-cell-voltage" typeId="cell-voltage">
				<label>Min Cell Voltage</label>
			</channel>
			<channel id="min-cell-voltage-cell" typeId="cell-number">
				<label>Min Voltage Cell</label>
			</channel>
			<channel id="average-cell-voltage" typeId="cell-voltage-calculated">
				<label>Average Cell Voltage</label>
			</channel>
			<channel id="cell-voltage-spread" typeId="cell-voltage-calculated">
				<label>Cell Voltage Spread</label>
				<description>Difference between highest and lowest cell voltage.</description>
			</channel>
			<channel id="max-cell-temperature" typeId="temperature">
				<label>Max Cell Temperature</label>
			</channel>
			<channel id="max-cell-temperature-sensor" typeId="cell-number">
				<label>Max Temperature Sensor</label>
			</channel>
			<channel id="min-cell-temperature" typeId="temperature">
				<label>Min Cell Temperature</label>
			</channel>
			<channel id="min-cell-temperature-sensor" typeId="cell-number">
				<label>Min Temperature Sensor</label>
			</channel>
			<channel id="average-cell-temperature" typeId="temperature-calculated">
				<label>Average Cell Temperature</label>
			</channel>
			<channel id="balancing-cells" typeId="balancing-cells"/>
			<channel id="warning" typeId="alarm">
				<label>Warning</label>
				<description>ON while the tower reports at least one warning.</description>
			</channel>
			<channel id="warnings" typeId="status-text">
				<label>Warnings</label>
				<description>Warnings reported by the tower.</description>
			</channel>
			<channel id="error" typeId="alarm">
				<label>Error</label>
				<description>ON while the tower reports at least one error.</description>
			</channel>
			<channel id="errors" typeId="status-text">
				<label>Errors</label>
				<description>Errors reported by the tower.</description>
			</channel>
		</channels>
	</channel-group-type>


	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<channel-group-type id="controls-ui">
		<label>Controls-UI</label>
		<channels>
			<channel id="button-light" typeId="button-light"/>
			<channel id="light-level" typeId="light-level"/>
			<channel id="displayed-index" typeId="displayed-index"/>
		</channels>
	</channel-group-type>
	<channel-group-type id="controls-basic">
		<label>Controls</label>
		<channels>
			<channel id="power" typeId="power"/>
			<channel id="fan-speed" typeId="fan-speed"/>
			<channel id="mode" typeId="mode"/>
			<channel id="timer" typeId="timer"/>
			<channel id="timer-remaining" typeId="timer-remaining"/>
			<channel id="child-lock" typeId="child-lock"/>

		</channels>
	</channel-group-type>
	<channel-group-type id="controls-adv">
		<label>Controls</label>
		<channels>
			<channel id="power" typeId="power"/>
			<channel id="fan-speed" typeId="fan-speed"/>
			<channel id="child-lock" typeId="child-lock"/>
			<channel id="mode" typeId="mode"/>

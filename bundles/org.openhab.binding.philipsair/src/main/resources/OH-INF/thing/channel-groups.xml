			<channel id="error-code" typeId="error-code"/>
		</channels>
	</channel-group-type>
	<channel-group-type id="sensors-adv">
		<label>Sensors</label>
		<channels>
			<channel id="pm25" typeId="pm25"/>
			<channel id="temperature" typeId="temperature"/>
			<channel id="humidity" typeId="humidity"/>
			<channel id="water-level" typeId="water-level"/>

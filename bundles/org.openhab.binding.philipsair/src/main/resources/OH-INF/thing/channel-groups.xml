			<channel id="air-quality-threshold" typeId="air-quality-threshold"/>
			<channel id="error-code" typeId="error-code"/>
		</channels>
	</channel-group-type>

	<channel-group-type id="filters">
		<label>Filters</label>
		<channels>
			<channel id="pre-filter-life" typeId="pre-filter-life"/>
			<channel id="hepa-filter-life" typeId="hepa-filter-life"/>
			<channel id="carbon-filter-life" typeId="carbon-filter-life"/>
		</channels>
	</channel-group-type>
	<channel-group-type id="filters-wicks">
		<label>Filters with Wick</label>
		<channels>
			<channel id="pre-filter-life" typeId="pre-filter-life"/>
			<channel id="hepa-filter-life" typeId="hepa-filter-life"/>
			<channel id="carbon-filter-life" typeId="carbon-filter-life"/>
			<channel id="wick-filter-life" typeId="wick-filter-life"/>
		</channels>

<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="e3dc"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<channel-type id="emergency-percent">
		<item-type>Number:Dimensionless</item-type>
		<label>Reserve</label>
		<description>Share of the battery kept for emergency power</description>
		<tags>
			<point>Setpoint</point>
			<property>StateOfCharge</property>
		</tags>
		<state pattern="%.0f %%"/>
		<command>
			<options>
				<option value="0 %">0 %</option>
				<option value="10 %">10 %</option>
				<option value="20 %">20 %</option>
				<option value="30 %">30 %</option>
				<option value="40 %">40 %</option>
				<option value="50 %">50 %</option>
				<option value="60 %">60 %</option>
				<option value="70 %">70 %</option>
				<option value="80 %">80 %</option>
				<option value="90 %">90 %</option>
				<option value="100 %">100 %</option>
			</options>
		</command>
	</channel-type>

	<channel-type id="emergency-energy">
		<item-type>Number:Energy</item-type>
		<label>Reserve Energy</label>
		<description>Energy kept for emergency power</description>
		<tags>
			<point>Setpoint</point>
			<property>Energy</property>
		</tags>
		<state pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="emergency-energy-max">
		<item-type>Number:Energy</item-type>
		<label>Maximum Reserve Energy</label>
		<description>Highest reserve the battery can hold for emergency power</description>
		<tags>
			<point>Measurement</point>
			<property>Energy</property>
		</tags>
		<state pattern="%.1f %unit%" readOnly="true"/>
	</channel-type>

	<channel-type id="emergency-last-soc">
		<item-type>Number:Dimensionless</item-type>
		<label>Reserve Last SoC</label>
		<description>State of charge the battery was left with for emergency power</description>
		<tags>
			<point>Measurement</point>
			<property>StateOfCharge</property>
		</tags>
		<state pattern="%.0f %%" readOnly="true"/>
	</channel-type>

</thing:thing-descriptions>

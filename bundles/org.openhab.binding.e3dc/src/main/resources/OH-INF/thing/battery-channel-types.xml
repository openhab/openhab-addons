<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="e3dc"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<channel-type id="battery-soc">
		<item-type>Number:Dimensionless</item-type>
		<label>State of Charge</label>
		<description>Battery state of charge</description>
		<state pattern="%.1f %%" readOnly="true"/>
	</channel-type>

	<channel-type id="battery-rsoc">
		<item-type>Number:Dimensionless</item-type>
		<label>Real State of Charge</label>
		<description>State of charge the battery reports itself</description>
		<state pattern="%.1f %%" readOnly="true"/>
	</channel-type>

	<channel-type id="battery-remaining-charge-power">
		<item-type>Number:Power</item-type>
		<label>Remaining Charge Power</label>
		<description>Charge power still available</description>
		<tags>
			<tag>Measurement</tag>
			<tag>Power</tag>
		</tags>
		<state pattern="%.0f %unit%" readOnly="true"/>
	</channel-type>

	<channel-type id="battery-remaining-discharge-power">
		<item-type>Number:Power</item-type>
		<label>Remaining Discharge Power</label>
		<description>Discharge power still available</description>
		<tags>
			<tag>Measurement</tag>
			<tag>Power</tag>
		</tags>
		<state pattern="%.0f %unit%" readOnly="true"/>
	</channel-type>

	<channel-type id="battery-max-charge-power">
		<item-type>Number:Power</item-type>
		<label>Maximum Charge Power</label>
		<description>Configured limit for battery charging</description>
		<state pattern="%.0f %unit%"/>
	</channel-type>

	<channel-type id="battery-max-discharge-power">
		<item-type>Number:Power</item-type>
		<label>Maximum Discharge Power</label>
		<description>Configured limit for battery discharging</description>
		<state pattern="%.0f %unit%"/>
	</channel-type>

	<channel-type id="battery-discharge-start-power">
		<item-type>Number:Power</item-type>
		<label>Discharge Start Power</label>
		<description>Power above which the battery is discharged</description>
		<state pattern="%.0f %unit%"/>
	</channel-type>

	<channel-type id="battery-charge-limit-battery">
		<item-type>Number:Power</item-type>
		<label>Battery Charge Limit</label>
		<description>Charge power limit reported by the battery</description>
		<tags>
			<tag>Measurement</tag>
			<tag>Power</tag>
		</tags>
		<state pattern="%.0f %unit%" readOnly="true"/>
	</channel-type>

	<channel-type id="battery-charge-limit-dcdc">
		<item-type>Number:Power</item-type>
		<label>DC/DC Charge Limit</label>
		<description>Charge power limit of the DC/DC converter</description>
		<tags>
			<tag>Measurement</tag>
			<tag>Power</tag>
		</tags>
		<state pattern="%.0f %unit%" readOnly="true"/>
	</channel-type>

	<channel-type id="battery-charge-limit-used">
		<item-type>Number:Power</item-type>
		<label>Used Charge Limit</label>
		<description>Charge power limit currently applied</description>
		<tags>
			<tag>Measurement</tag>
			<tag>Power</tag>
		</tags>
		<state pattern="%.0f %unit%" readOnly="true"/>
	</channel-type>

	<channel-type id="battery-charge-limit-user">
		<item-type>Number:Power</item-type>
		<label>User Charge Limit</label>
		<description>Charge power limit set by the user</description>
		<tags>
			<tag>Measurement</tag>
			<tag>Power</tag>
		</tags>
		<state pattern="%.0f %unit%" readOnly="true"/>
	</channel-type>

	<channel-type id="battery-discharge-limit-battery">
		<item-type>Number:Power</item-type>
		<label>Battery Discharge Limit</label>
		<description>Discharge power limit reported by the battery</description>
		<tags>
			<tag>Measurement</tag>
			<tag>Power</tag>
		</tags>
		<state pattern="%.0f %unit%" readOnly="true"/>
	</channel-type>

	<channel-type id="battery-discharge-limit-dcdc">
		<item-type>Number:Power</item-type>
		<label>DC/DC Discharge Limit</label>
		<description>Discharge power limit of the DC/DC converter</description>
		<tags>
			<tag>Measurement</tag>
			<tag>Power</tag>
		</tags>
		<state pattern="%.0f %unit%" readOnly="true"/>
	</channel-type>

	<channel-type id="battery-discharge-limit-used">
		<item-type>Number:Power</item-type>
		<label>Used Discharge Limit</label>
		<description>Discharge power limit currently applied</description>
		<tags>
			<tag>Measurement</tag>
			<tag>Power</tag>
		</tags>
		<state pattern="%.0f %unit%" readOnly="true"/>
	</channel-type>

	<channel-type id="battery-discharge-limit-user">
		<item-type>Number:Power</item-type>
		<label>User Discharge Limit</label>
		<description>Discharge power limit set by the user</description>
		<tags>
			<tag>Measurement</tag>
			<tag>Power</tag>
		</tags>
		<state pattern="%.0f %unit%" readOnly="true"/>
	</channel-type>

	<channel-type id="battery-wallbox-discharge-to-car">
		<item-type>Switch</item-type>
		<label>Discharge Battery to Car</label>
		<description>The house battery may discharge into the car</description>
		<state/>
	</channel-type>

	<channel-type id="battery-wallbox-charge-before-car">
		<item-type>Switch</item-type>
		<label>Charge Battery before Car</label>
		<description>The house battery is charged before the car</description>
		<state/>
	</channel-type>

	<channel-type id="battery-wallbox-discharge-until">
		<item-type>Number:Dimensionless</item-type>
		<label>Discharge Battery until</label>
		<description>State of charge down to which the battery may discharge into the car</description>
		<state pattern="%.0f %%"/>
	</channel-type>

	<channel-type id="battery-wallbox-disable-at-mix-mode">
		<item-type>Switch</item-type>
		<label>Battery Off in Mix Mode</label>
		<description>No battery charging while the wallbox charges in mix mode</description>
		<state/>
	</channel-type>

</thing:thing-descriptions>

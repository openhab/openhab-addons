			<channel id="apparentEnergyOutL1" typeId="apparentEnergyOutTypeL1"/>
			<channel id="apparentPowerInL2" typeId="apparentPowerInTypeL2"/>
			<channel id="apparentPowerOutL2" typeId="apparentPowerOutTypeL2"/>
			<channel id="apparentEnergyInL2" typeId="apparentEnergyInTypeL2"/>
			<channel id="apparentEnergyOutL2" typeId="apparentEnergyOutTypeL2"/>
			<channel id="apparentPowerInL3" typeId="apparentPowerInTypeL3"/>
			<channel id="apparentPowerOutL3" typeId="apparentPowerOutTypeL3"/>
			<channel id="apparentEnergyInL3" typeId="apparentEnergyInTypeL3"/>
			<channel id="apparentEnergyOutL3" typeId="apparentEnergyOutTypeL3"/>
			<channel id="powerFactor" typeId="powerFactorType"/>
			<channel id="powerFactorL1" typeId="powerFactorTypeL1"/>
			<channel id="powerFactorL2" typeId="powerFactorTypeL2"/>
			<channel id="powerFactorL3" typeId="powerFactorTypeL3"/>
			<channel id="currentL1" typeId="currentTypeL1"/>
			<channel id="currentL2" typeId="currentTypeL2"/>
			<channel id="currentL3" typeId="currentTypeL3"/>
			<channel id="voltageL1" typeId="voltageTypeL1"/>
			<channel id="voltageL2" typeId="voltageTypeL2"/>
			<channel id="voltageL3" typeId="voltageTypeL3"/>
			<channel id="frequency" typeId="frequencyType"/>
			<channel id="version" typeId="versionType"/>
		</channels>

		<properties>
			<property name="vendor">Vendor</property>
			<property name="serialNumber">Serial Number</property>
		</properties>

		<config-description>
			<parameter name="serialNumber" type="text" required="true">
				<label>Serial number</label>
				<description>Decimal serial number of meter; existing hexadecimal values remain supported</description>
			</parameter>
			<parameter name="mcastGroup" type="text" required="true">
				<label>Multicast Group</label>
				<description>IP address of the multicast group</description>
				<default>239.12.255.254</default>
			</parameter>
			<parameter name="port" type="integer" required="false" min="1024" max="49151">
				<label>Port</label>
				<description>Port of the multicast group</description>
				<default>9522</default>
				<advanced>true</advanced>
			</parameter>
			<parameter name="pollingPeriod" type="integer" required="false">
				<label>Polling Period</label>
				<description>Polling period for refreshing the data in s</description>
				<default>30</default>
				<advanced>true</advanced>
			</parameter>
		</config-description>
	</thing-type>


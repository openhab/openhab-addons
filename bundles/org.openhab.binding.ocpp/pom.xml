<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.openhab.addons.bundles</groupId>
    <artifactId>org.openhab.addons.reactor.bundles</artifactId>
    <version>5.3.0-SNAPSHOT</version>
  </parent>

  <artifactId>org.openhab.binding.ocpp</artifactId>

  <name>openHAB Add-ons :: Bundles :: OCPP Binding</name>

  <properties>
    <ocpp.version>2.0</ocpp.version>
    <websocket.version>1.6.0</websocket.version>
    <!-- The ChargeTime jars reference JAXB and javax.annotation, neither of which the runtime exports;
         the classes that use them are never loaded, so the imports are optional. -->
    <bnd.importpackage>javax.xml.bind.*;resolution:=optional,javax.annotation;resolution:=optional</bnd.importpackage>
  </properties>

  <dependencies>
    <!-- ChargeTime OCA-OCPP: ocpp16 (models and profiles), ocpp-json (transport), ocpp-common (base).
         slf4j, gson and jaxb come from the platform and are excluded. -->
    <dependency>
      <groupId>eu.chargetime.ocpp</groupId>
      <artifactId>ocpp16</artifactId>
      <version>${ocpp.version}</version>
      <scope>compile</scope>
      <exclusions>
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-api</artifactId>
        </exclusion>
        <exclusion>
          <groupId>javax.xml.bind</groupId>
          <artifactId>jaxb-api</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>eu.chargetime.ocpp</groupId>
      <artifactId>ocpp-json</artifactId>
      <version>${ocpp.version}</version>
      <scope>compile</scope>
      <exclusions>
        <exclusion>
          <groupId>com.google.code.gson</groupId>
          <artifactId>gson</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-api</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>eu.chargetime.ocpp</groupId>
      <artifactId>ocpp-common</artifactId>
      <version>${ocpp.version}</version>
      <scope>compile</scope>
      <exclusions>
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-api</artifactId>
        </exclusion>
        <exclusion>
          <groupId>javax.xml.bind</groupId>
          <artifactId>jaxb-api</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Declared directly, not for a version: the reactor embeds only direct dependencies
         (excludeTransitive), and this one has to be inlined for the bundle to resolve. -->
    <dependency>
      <groupId>org.java-websocket</groupId>
      <artifactId>Java-WebSocket</artifactId>
      <version>${websocket.version}</version>
      <scope>compile</scope>
    </dependency>
  </dependencies>

</project>

<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="shelly"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<thing-type id="shellyplusflood">
		<label>Shelly Plus Flood</label>
		<description>Shelly Flood Gen4 / Flood S Gen4 - Water Leak Detector (battery powered)</description>
		<category>Sensor</category>
		<semantic-equipment-tag>LeakSensor</semantic-equipment-tag>
		<channel-groups>
			<channel-group id="sensors" typeId="sensorData"/>
			<channel-group id="control" typeId="control"/>
			<channel-group id="battery" typeId="batteryStatus"/>
			<channel-group id="device" typeId="deviceStatus"/>
		</channel-groups>

		<representation-property>serviceName</representation-property>
		<config-description-ref uri="thing-type:shelly:battery-gen2"/>
	</thing-type>

	<thing-type id="shellyplusht">
		<label>ShellyPlus H&amp;T</label>
		<description>Shelly Plus HT - Humidity and Temperature sensor with display</description>
		<category>Sensor</category>
		<semantic-equipment-tag>Sensor</semantic-equipment-tag>
		<channel-groups>
			<channel-group id="sensors" typeId="sensorData"/>
			<channel-group id="battery" typeId="batteryStatus"/>
			<channel-group id="device" typeId="deviceStatus"/>
		</channel-groups>

		<representation-property>serviceName</representation-property>
		<config-description-ref uri="thing-type:shelly:battery-gen2"/>
	</thing-type>

	<thing-type id="shellyplussmoke">
		<label>Shelly Plus Smoke</label>
		<description>Shelly Plus Smoke - Smoke Detector with Alarm</description>
		<category>SmokeDetector</category>
		<semantic-equipment-tag>SmokeDetector</semantic-equipment-tag>
		<channel-groups>
			<channel-group id="sensors" typeId="sensorData"/>
			<channel-group id="control" typeId="control"/>
			<channel-group id="battery" typeId="batteryStatus"/>
			<channel-group id="device" typeId="deviceStatus"/>
		</channel-groups>

		<representation-property>serviceName</representation-property>
		<config-description-ref uri="thing-type:shelly:battery-gen2"/>
	</thing-type>

	<thing-type id="shellywalldisplay">
		<label>Shelly Wall Display</label>
		<description>Shelly Wall Display with sensors and input/output</description>
		<category>Sensor</category>
		<semantic-equipment-tag>ControlDevice</semantic-equipment-tag>
		<channel-groups>
			<channel-group id="sensors" typeId="sensorData"/>
			<channel-group id="relay" typeId="relayChannel"/>
			<channel-group id="device" typeId="deviceStatus"/>
			<channel-group id="media" typeId="mediaPlayer"/>
		</channel-groups>

		<representation-property>serviceName</representation-property>
		<config-description-ref uri="thing-type:shelly:relay-gen2"/>
	</thing-type>

	<channel-type id="floodAlarmMode">
		<item-type>String</item-type>
		<label>Alarm Mode</label>
		<description>Flood sensor alarm mode.</description>
		<state readOnly="false">
			<options>
				<option value="rain">Rain — rain detection only, no flood alarm</option>
				<option value="intense">Flood, Intense — loud acoustic alarm, can be muted</option>
				<option value="normal">Flood, Normal — acoustic alarm enabled, can be muted</option>
				<option value="disabled">Flood, Silent — flood detection only, no acoustic alarm</option>
			</options>
		</state>
	</channel-type>

	<channel-type id="floodReportHoldoff">
		<item-type>Number:Time</item-type>
		<label>Report Holdoff</label>
		<description>Minimum time in seconds between consecutive flood alarm reports (0-60s)</description>
		<category>Time</category>
		<state min="0" max="60" step="5" pattern="%.0f %unit%"/>
	</channel-type>

	<channel-group-type id="mediaPlayer">
		<label>Media Player</label>
		<description>Media playback control (Wall Display Media component)</description>
	</channel-group-type>

	<channel-type id="mediaControl">
		<item-type>Player</item-type>
		<label>Playback Control</label>
		<description>Control media playback (play/pause/next/previous)</description>
		<state readOnly="false"/>
	</channel-type>

	<channel-type id="mediaVolume">
		<item-type>Dimmer</item-type>
		<label>Volume</label>
		<description>Media player volume in percent</description>
		<state readOnly="false" min="0" max="100" pattern="%.0f %%"/>
	</channel-type>

	<channel-type id="mediaTitle" advanced="true">
		<item-type>String</item-type>
		<label>Title</label>
		<description>Title of the currently playing media</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="mediaArtist" advanced="true">
		<item-type>String</item-type>
		<label>Artist</label>
		<description>Artist of the currently playing media</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="mediaAlbum" advanced="true">
		<item-type>String</item-type>
		<label>Album</label>
		<description>Album of the currently playing media</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="mediaContentType" advanced="true">
		<item-type>String</item-type>
		<label>Media Type</label>
		<description>Type of the currently playing media (e.g. AUDIO, RADIO)</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="playMediaId" advanced="true">
		<item-type>Number</item-type>
		<label>Play Media</label>
		<description>Start playback of a library item by its id</description>
		<state readOnly="false"/>
	</channel-type>

	<channel-type id="playRadioFavId" advanced="true">
		<item-type>Number</item-type>
		<label>Play Radio Favorite</label>
		<description>Start playback of a radio favorite by its id</description>
		<state readOnly="false"/>
	</channel-type>

</thing:thing-descriptions>

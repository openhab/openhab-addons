<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="bmwcardata"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<thing-type id="vehicle">
		<supported-bridge-type-refs>
			<bridge-type-ref id="account"/>
		</supported-bridge-type-refs>

		<label>BMW CarData Vehicle</label>
		<description>A vehicle mapped to the BMW CarData account</description>
		<semantic-equipment-tag>Car</semantic-equipment-tag>

		<channel-groups>
			<channel-group id="status" typeId="status-group"/>
			<channel-group id="range" typeId="range-group"/>
			<channel-group id="charge" typeId="charge-group"/>
			<channel-group id="battery" typeId="battery-group"/>
			<channel-group id="climate" typeId="climate-group"/>
			<channel-group id="navigation" typeId="navigation-group"/>
			<channel-group id="trip" typeId="trip-group"/>
			<channel-group id="tyres" typeId="tyres-group"/>
			<channel-group id="security" typeId="security-group"/>
			<channel-group id="service" typeId="service-group"/>
			<channel-group id="statistics" typeId="statistics-group"/>
			<channel-group id="other" typeId="other-group"/>
		</channel-groups>

		<properties>
			<property name="vendor">BMW Group</property>
		</properties>
		<representation-property>vin</representation-property>

		<config-description>
			<parameter name="vin" type="text" required="true">
				<label>Vehicle Identification Number</label>
				<description>The 17 character VIN of the vehicle.</description>
			</parameter>
			<parameter name="dynamicChannels" type="boolean">
				<label>Dynamic Channels</label>
				<description>Create a channel for each received data point without predefined channel, e.g. data selected for
					the
					stream in the customer portal.</description>
				<default>true</default>
				<advanced>true</advanced>
			</parameter>
		</config-description>
	</thing-type>

	<channel-group-type id="status-group">
		<label>Vehicle Status</label>
		<channels>
			<channel id="door-lock" typeId="door-lock"/>
			<channel id="trunk" typeId="door">
				<label>Trunk</label>
				<description>Whether the trunk is open</description>
			</channel>
			<channel id="hood" typeId="door">
				<label>Hood</label>
				<description>Whether the hood is open</description>
			</channel>
			<channel id="trunk-locked" typeId="trunk-locked"/>
			<channel id="door-front-driver" typeId="door">
				<label>Front Driver Door</label>
				<description>Whether the front door on the driver side is open</description>
			</channel>
			<channel id="door-front-passenger" typeId="door">
				<label>Front Passenger Door</label>
				<description>Whether the front door on the passenger side is open</description>
			</channel>
			<channel id="door-rear-driver" typeId="door">
				<label>Rear Driver Door</label>
				<description>Whether the rear door on the driver side is open</description>
			</channel>
			<channel id="door-rear-passenger" typeId="door">
				<label>Rear Passenger Door</label>
				<description>Whether the rear door on the passenger side is open</description>
			</channel>
			<channel id="window-front-driver" typeId="window">
				<label>Front Driver Window</label>
			</channel>
			<channel id="window-front-driver-state" typeId="window-state">
				<label>Front Driver Window State</label>
			</channel>
			<channel id="window-front-passenger" typeId="window">
				<label>Front Passenger Window</label>
			</channel>
			<channel id="window-front-passenger-state" typeId="window-state">
				<label>Front Passenger Window State</label>
			</channel>
			<channel id="window-rear-driver" typeId="window">
				<label>Rear Driver Window</label>
			</channel>
			<channel id="window-rear-driver-state" typeId="window-state">
				<label>Rear Driver Window State</label>
			</channel>
			<channel id="window-rear-passenger" typeId="window">
				<label>Rear Passenger Window</label>
			</channel>
			<channel id="window-rear-passenger-state" typeId="window-state">
				<label>Rear Passenger Window State</label>
			</channel>
			<channel id="rear-window" typeId="window">
				<label>Rear Window</label>
				<description>Whether the rear window is open</description>
			</channel>
			<channel id="sunroof" typeId="window">
				<label>Sunroof</label>
				<description>Whether the sunroof is open or tilted</description>
			</channel>
			<channel id="sunroof-state" typeId="sunroof-state"/>
			<channel id="moving" typeId="moving"/>
			<channel id="ignition" typeId="ignition"/>
			<channel id="engine" typeId="engine"/>
			<channel id="deep-sleep" typeId="deep-sleep"/>
			<channel id="battery-voltage" typeId="battery-voltage"/>
			<channel id="battery-soc" typeId="battery-soc"/>
			<channel id="last-update" typeId="last-update"/>
			<channel id="image" typeId="image"/>
		</channels>
	</channel-group-type>


	<channel-group-type id="range-group">
		<label>Range</label>
		<channels>
			<channel id="mileage" typeId="mileage"/>
			<channel id="total" typeId="range">
				<label>Total Range</label>
				<description>Total remaining range</description>
			</channel>
			<channel id="electric" typeId="range">
				<label>Electric Range</label>
				<description>Remaining electric range</description>
			</channel>
			<channel id="electric-charging-forecast" typeId="range-forecast">
				<label>Electric Range Forecast</label>
				<description>Predicted electric range during charging</description>
			</channel>
			<channel id="electric-target" typeId="range">
				<label>Electric Range at Target</label>
				<description>Electric range at the target state of charge</description>
			</channel>
			<channel id="fuel-level" typeId="fuel-level"/>
			<channel id="remaining-fuel" typeId="remaining-fuel"/>
		</channels>
	</channel-group-type>

	<channel-group-type id="charge-group">
		<label>Charging</label>
		<channels>
			<channel id="soc" typeId="soc"/>
			<channel id="target-soc" typeId="target-soc"/>
			<channel id="status" typeId="charging-status"/>
			<channel id="plugged" typeId="plugged"/>
			<channel id="power" typeId="charging-power"/>
			<channel id="time-remaining" typeId="charging-time-remaining"/>
			<channel id="ac-current" typeId="charging-current">
				<label>AC Charging Current</label>
				<description>Current AC charging current</description>
			</channel>
			<channel id="ac-voltage" typeId="charging-voltage"/>
			<channel id="ac-limit" typeId="current-limit">
				<label>AC Charging Limit</label>
				<description>Selected limit of the AC charging current</description>
			</channel>
			<channel id="ac-limit-min" typeId="current-limit">
				<label>Minimum AC Charging Limit</label>
				<description>Lowest limit of the AC charging current that can be selected</description>
			</channel>
			<channel id="ac-limit-max" typeId="current-limit">
				<label>Maximum AC Charging Limit</label>
				<description>Highest limit of the AC charging current that can be selected</description>
			</channel>
			<channel id="phases" typeId="charging-phases"/>
			<channel id="method" typeId="charging-method"/>
			<channel id="port" typeId="port"/>
			<channel id="predicted-soc" typeId="predicted-soc"/>
			<channel id="min-target-soc" typeId="min-target-soc"/>
			<channel id="time-to-full" typeId="time-to-full"/>
			<channel id="mode" typeId="charging-mode"/>
			<channel id="end-reason" typeId="charging-end-reason"/>
			<channel id="last-result" typeId="last-charging-result"/>
			<channel id="cable-lock" typeId="cable-lock"/>
			<channel id="flap" typeId="charging-flap"/>
			<channel id="flap-locked" typeId="charging-flap-locked"/>
		</channels>
	</channel-group-type>

	<channel-group-type id="battery-group">
		<label>High-Voltage Battery</label>
		<channels>
			<channel id="capacity" typeId="battery-energy">
				<label>Battery Capacity</label>
				<description>Size of the high-voltage battery</description>
			</channel>
			<channel id="energy-content" typeId="battery-energy">
				<label>Energy Content</label>
				<description>Maximum energy content of the high-voltage battery</description>
			</channel>
			<channel id="health" typeId="battery-health"/>
			<channel id="energy-to-full" typeId="energy-to-full"/>
		</channels>
	</channel-group-type>

	<channel-group-type id="security-group">
		<label>Security</label>
		<channels>
			<channel id="alarm" typeId="alarm"/>
			<channel id="arm-status" typeId="alarm-arm-status"/>
			<channel id="activation-time" typeId="alarm-activation-time"/>
		</channels>
	</channel-group-type>

	<channel-group-type id="service-group">
		<label>Service</label>
		<channels>
			<channel id="distance" typeId="service-distance"/>
			<channel id="inspection-date" typeId="inspection-date"/>
		</channels>
	</channel-group-type>

	<channel-group-type id="statistics-group">
		<label>Statistics</label>
		<channels>
			<channel id="grid-energy" typeId="grid-energy"/>
			<channel id="fuel-consumed" typeId="fuel-consumed"/>
			<channel id="avg-consumption" typeId="avg-consumption"/>
			<channel id="avg-speed" typeId="avg-speed"/>
			<channel id="weekly-distance" typeId="weekly-distance">
				<label>Weekly Distance</label>
				<description>Average distance driven per week</description>
			</channel>
			<channel id="weekly-distance-long-term" typeId="weekly-distance">
				<label>Weekly Distance (Long-Term)</label>
				<description>Average distance driven per week over two months</description>
			</channel>
		</channels>
	</channel-group-type>

	<channel-group-type id="climate-group">
		<label>Climate</label>
		<channels>
			<channel id="comfort-state" typeId="comfort-state"/>
			<channel id="progress" typeId="preconditioning-progress"/>
			<channel id="remaining-running-time" typeId="preconditioning-remaining-time">
				<label>Preconditioning Remaining Time</label>
				<description>Remaining running time of the preconditioning</description>
			</channel>
			<channel id="target-temperature" typeId="target-temperature"/>
			<channel id="rear-defrost" typeId="heating-active">
				<label>Rear Window Heating</label>
				<description>Whether the rear window heating is active</description>
			</channel>
			<channel id="mirror-heating" typeId="heating-active">
				<label>Mirror Heating</label>
				<description>Whether the exterior mirror heating is active</description>
			</channel>
			<channel id="air-purification" typeId="air-purification"/>
			<channel id="auxiliary-activity" typeId="auxiliary-activity"/>
			<channel id="auxiliary-remaining-time" typeId="preconditioning-remaining-time">
				<label>Auxiliary Climate Remaining Time</label>
				<description>Remaining running time of the auxiliary climate control</description>
			</channel>
			<channel id="auxiliary-error" typeId="auxiliary-error"/>
		</channels>
	</channel-group-type>

	<channel-group-type id="navigation-group">
		<label>Navigation</label>
		<channels>
			<channel id="gps" typeId="system.location">
				<label>GPS Location</label>
				<description>Current location of the vehicle</description>
			</channel>
			<channel id="heading" typeId="heading"/>
			<channel id="altitude" typeId="altitude"/>
			<channel id="gps-fix" typeId="gps-fix"/>
			<channel id="destination-distance" typeId="destination-distance"/>
			<channel id="arrival-time" typeId="arrival-time"/>
		</channels>
	</channel-group-type>

	<channel-group-type id="trip-group">
		<label>Last Trip</label>
		<channels>
			<channel id="end-time" typeId="trip-end-time"/>
			<channel id="end-mileage" typeId="trip-end-mileage"/>
			<channel id="end-soc" typeId="trip-end-soc"/>
			<channel id="recuperation" typeId="trip-recuperation"/>
			<channel id="comfort-energy" typeId="trip-comfort-energy"/>
			<channel id="electric-share" typeId="trip-share">
				<label>Electric Share</label>
				<description>Share of the distance driven electrically</description>
			</channel>
			<channel id="eco-pro-share" typeId="trip-share">
				<label>ECO PRO Share</label>
				<description>Share of the trip driven in ECO PRO mode</description>
			</channel>
			<channel id="eco-pro-plus-share" typeId="trip-share">
				<label>ECO PRO+ Share</label>
				<description>Share of the trip driven in ECO PRO+ mode</description>
			</channel>
			<channel id="acceleration-rating" typeId="trip-rating">
				<label>Acceleration Rating</label>
				<description>Rating of the acceleration behaviour from 0 to 5 stars</description>
			</channel>
			<channel id="anticipation-rating" typeId="trip-rating">
				<label>Anticipation Rating</label>
				<description>Rating of the anticipatory driving from 0 to 5 stars</description>
			</channel>
		</channels>
	</channel-group-type>

	<channel-group-type id="tyres-group">
		<label>Tyres</label>
		<channels>
			<channel id="pressure-front-left" typeId="tyre-pressure">
				<label>Front Left Pressure</label>
			</channel>
			<channel id="pressure-front-right" typeId="tyre-pressure">
				<label>Front Right Pressure</label>
			</channel>
			<channel id="pressure-rear-left" typeId="tyre-pressure">
				<label>Rear Left Pressure</label>
			</channel>
			<channel id="pressure-rear-right" typeId="tyre-pressure">
				<label>Rear Right Pressure</label>
			</channel>
			<channel id="target-front-left" typeId="tyre-target-pressure">
				<label>Front Left Target Pressure</label>
			</channel>
			<channel id="target-front-right" typeId="tyre-target-pressure">
				<label>Front Right Target Pressure</label>
			</channel>
			<channel id="target-rear-left" typeId="tyre-target-pressure">
				<label>Rear Left Target Pressure</label>
			</channel>
			<channel id="target-rear-right" typeId="tyre-target-pressure">
				<label>Rear Right Target Pressure</label>
			</channel>
			<channel id="temperature-front-left" typeId="tyre-temperature">
				<label>Front Left Temperature</label>
			</channel>
			<channel id="temperature-front-right" typeId="tyre-temperature">
				<label>Front Right Temperature</label>
			</channel>
			<channel id="temperature-rear-left" typeId="tyre-temperature">
				<label>Rear Left Temperature</label>
			</channel>
			<channel id="temperature-rear-right" typeId="tyre-temperature">
				<label>Rear Right Temperature</label>
			</channel>
		</channels>
	</channel-group-type>

	<channel-type id="door-lock">
		<item-type>String</item-type>
		<label>Door Lock</label>
		<description>Lock state of the doors as reported by the vehicle</description>
		<category>Lock</category>
		<tags>
			<tag>Status</tag>
			<tag>LockState</tag>
		</tags>
		<state readOnly="true">
			<options>
				<option value="SECURED">Secured</option>
				<option value="LOCKED">Locked</option>
				<option value="SELECTIVELOCKED">Partly Locked</option>
				<option value="UNLOCKED">Unlocked</option>
			</options>
		</state>
	</channel-type>

	<channel-type id="door">
		<item-type>Contact</item-type>
		<label>Door</label>
		<description>Whether the door is open</description>
		<category>Door</category>
		<tags>
			<tag>Status</tag>
			<tag>OpenState</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="window">
		<item-type>Contact</item-type>
		<label>Window</label>
		<description>Whether the window is open; a partly open window is open</description>
		<category>Window</category>
		<tags>
			<tag>Status</tag>
			<tag>OpenState</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="window-state" advanced="true">
		<item-type>String</item-type>
		<label>Window State</label>
		<description>State of the window as reported by the vehicle</description>
		<category>Window</category>
		<tags>
			<tag>Status</tag>
			<tag>OpenLevel</tag>
		</tags>
		<state readOnly="true">
			<options>
				<option value="CLOSED">Closed</option>
				<option value="INTERMEDIATE">Partly Open</option>
				<option value="OPEN">Open</option>
			</options>
		</state>
	</channel-type>

	<channel-type id="sunroof-state" advanced="true">
		<item-type>String</item-type>
		<label>Sunroof State</label>
		<description>Overall state of the sunroof as reported by the vehicle</description>
		<category>Window</category>
		<tags>
			<tag>Status</tag>
			<tag>OpenLevel</tag>
		</tags>
		<state readOnly="true">
			<options>
				<option value="CLOSED">Closed</option>
				<option value="OPEN">Open</option>
				<option value="OPEN_TILT">Tilted</option>
				<option value="INTERMEDIATE_TILT">Partly Tilted</option>
			</options>
		</state>
	</channel-type>

	<channel-type id="deep-sleep" advanced="true">
		<item-type>Switch</item-type>
		<label>Deep Sleep</label>
		<description>Whether the deep sleep mode is active, which keeps most systems off to save the 12V battery while
			parked
			for a long time</description>
		<tags>
			<tag>Status</tag>
			<tag>Mode</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="current-limit" advanced="true">
		<item-type unitHint="A">Number:ElectricCurrent</item-type>
		<label>AC Charging Limit</label>
		<description>Selected limit of the AC charging current</description>
		<category>Energy</category>
		<tags>
			<tag>Status</tag>
			<tag>Current</tag>
		</tags>
		<state readOnly="true" pattern="%d %unit%"/>
	</channel-type>

	<channel-type id="moving">
		<item-type>Switch</item-type>
		<label>Moving</label>
		<description>Whether the vehicle is moving</description>
		<category>Motion</category>
		<tags>
			<tag>Status</tag>
			<tag>Motion</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="battery-voltage" advanced="true">
		<item-type unitHint="V">Number:ElectricPotential</item-type>
		<label>12V Battery Voltage</label>
		<description>Voltage of the 12V battery</description>
		<category>Energy</category>
		<tags>
			<tag>Measurement</tag>
			<tag>Voltage</tag>
		</tags>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="image">
		<item-type>Image</item-type>
		<label>Vehicle Image</label>
		<description>Picture of the vehicle provided by BMW, retrieved only while an item is linked</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="last-update">
		<item-type>DateTime</item-type>
		<label>Last Update</label>
		<description>Time of the most recent data reported by the vehicle</description>
		<category>Time</category>
		<tags>
			<tag>Status</tag>
			<tag>Timestamp</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="mileage">
		<item-type unitHint="km,mi">Number:Length</item-type>
		<label>Mileage</label>
		<description>Total distance travelled by the vehicle</description>
		<category>Line</category>
		<tags>
			<tag>Measurement</tag>
		</tags>
		<state readOnly="true" pattern="%d %unit%"/>
	</channel-type>

	<channel-type id="range">
		<item-type unitHint="km,mi">Number:Length</item-type>
		<label>Range</label>
		<category>Line</category>
		<tags>
			<tag>Calculation</tag>
		</tags>
		<state readOnly="true" pattern="%d %unit%"/>
	</channel-type>
	<channel-type id="range-forecast" advanced="true">
		<item-type unitHint="km,mi">Number:Length</item-type>
		<label>Range Forecast</label>
		<category>Line</category>
		<tags>
			<tag>Forecast</tag>
		</tags>
		<state readOnly="true" pattern="%d %unit%"/>
	</channel-type>

	<channel-type id="fuel-level">
		<item-type unitHint="%">Number:Dimensionless</item-type>
		<label>Fuel Level</label>
		<description>Fill level of the fuel tank</description>
		<category>Oil</category>
		<tags>
			<tag>Measurement</tag>
			<tag>Level</tag>
		</tags>
		<state readOnly="true" pattern="%d %%"/>
	</channel-type>

	<channel-type id="remaining-fuel">
		<item-type unitHint="l,gal">Number:Volume</item-type>
		<label>Remaining Fuel</label>
		<description>Amount of fuel in the tank</description>
		<category>Oil</category>
		<tags>
			<tag>Measurement</tag>
			<tag>Level</tag>
		</tags>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="soc">
		<item-type unitHint="%">Number:Dimensionless</item-type>
		<label>State of Charge</label>
		<description>State of charge of the high-voltage battery</description>
		<category>BatteryLevel</category>
		<tags>
			<tag>Measurement</tag>
			<tag>StateOfCharge</tag>
		</tags>
		<state readOnly="true" pattern="%d %%"/>
	</channel-type>

	<channel-type id="target-soc">
		<item-type unitHint="%">Number:Dimensionless</item-type>
		<label>Target State of Charge</label>
		<description>State of charge at which charging stops</description>
		<category>BatteryLevel</category>
		<tags>
			<tag>Status</tag>
			<tag>StateOfCharge</tag>
		</tags>
		<state readOnly="true" pattern="%d %%"/>
	</channel-type>

	<channel-type id="charging-status">
		<item-type>String</item-type>
		<label>Charging Status</label>
		<description>Charging state as reported by the vehicle</description>
		<category>Energy</category>
		<tags>
			<tag>Status</tag>
			<tag>Power</tag>
		</tags>
		<state readOnly="true">
			<options>
				<option value="NOCHARGING">Not Charging</option>
				<option value="INITIALIZATION">Initializing</option>
				<option value="CHARGINGACTIVE">Charging</option>
				<option value="CHARGINGPAUSED">Paused</option>
				<option value="CHARGINGENDED">Ended</option>
				<option value="CHARGINGERROR">Error</option>
				<option value="CHARGINGINTERRUPTED">Interrupted</option>
				<option value="CHARGINGDISRUPTED">Disrupted</option>
			</options>
		</state>
	</channel-type>

	<channel-type id="plugged">
		<item-type>Switch</item-type>
		<label>Plugged</label>
		<description>Whether a charging cable is plugged in</description>
		<category>PowerOutlet</category>
		<tags>
			<tag>Status</tag>
			<tag>Presence</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="charging-power">
		<item-type unitHint="kW">Number:Power</item-type>

<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="keba"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<thing-type id="kecontact-modbus">
		<label>KeContact (Modbus TCP)</label>
		<description>A KEBA KeContact P30 or P40 EV Charging Station accessed via its Modbus TCP interface</description>
		<semantic-equipment-tag>EVSE</semantic-equipment-tag>
		<channels>
			<channel id="state" typeId="modbus-state"/>
			<channel id="cablestate" typeId="modbus-cablestate"/>
			<channel id="errorcode" typeId="modbus-errorcode"/>
			<channel id="I1" typeId="modbus-current">
				<label>Current Phase 1</label>
			</channel>
			<channel id="I2" typeId="modbus-current">
				<label>Current Phase 2</label>
			</channel>
			<channel id="I3" typeId="modbus-current">
				<label>Current Phase 3</label>
			</channel>
			<channel id="serial" typeId="modbus-serial"/>
			<channel id="power" typeId="modbus-power"/>
			<channel id="totalconsumption" typeId="modbus-totalenergy"/>
			<channel id="U1" typeId="modbus-voltage">
				<label>Voltage Phase 1</label>
			</channel>
			<channel id="U2" typeId="modbus-voltage">
				<label>Voltage Phase 2</label>
			</channel>
			<channel id="U3" typeId="modbus-voltage">
				<label>Voltage Phase 3</label>
			</channel>
			<channel id="powerfactor" typeId="modbus-powerfactor"/>
			<channel id="maxchargingcurrent" typeId="modbus-maxchargingcurrent"/>
			<channel id="maxsupportedcurrent" typeId="modbus-maxsupportedcurrent"/>
			<channel id="sessionrfidtag" typeId="modbus-rfidtag"/>
			<channel id="sessionconsumption" typeId="modbus-sessionenergy"/>
			<channel id="phaseswitchsource" typeId="modbus-phaseswitchsource"/>
			<channel id="phaseswitchstate" typeId="modbus-phaseswitchstate"/>
			<channel id="failsafecurrentsetting" typeId="modbus-failsafecurrent"/>
			<channel id="failsafetimeoutsetting" typeId="modbus-failsafetimeout"/>
			<channel id="setchargingcurrent" typeId="modbus-setchargingcurrent"/>
			<channel id="setenergylimit" typeId="modbus-setenergylimit"/>
			<channel id="unlockplug" typeId="modbus-unlockplug"/>
			<channel id="enableduser" typeId="modbus-enableduser"/>
			<channel id="triggerphaseswitch" typeId="modbus-triggerphaseswitch"/>
		</channels>

		<properties>
			<property name="thingTypeVersion">1</property>
		</properties>

		<config-description>
			<parameter name="ipAddress" type="text" required="true">
				<context>network-address</context>
				<label>Network Address</label>
				<description>Network address of the wallbox</description>
			</parameter>
			<parameter name="port" type="integer" min="1" max="65535">
				<label>Port</label>
				<description>TCP port of the Modbus TCP interface of the wallbox</description>
				<default>502</default>
			</parameter>
			<parameter name="unitId" type="integer" min="0" max="255">
				<label>Unit ID</label>
				<description>Modbus unit id (slave address) of the wallbox</description>
				<default>255</default>
			</parameter>
			<parameter name="refreshInterval" type="integer" min="10" unit="s">
				<label>Fast Refresh Interval</label>
				<description>Refresh interval in seconds for frequently changing values</description>
				<default>12</default>
			</parameter>
			<parameter name="refreshIntervalSlow" type="integer" min="10" unit="s">
				<label>Slow Refresh Interval</label>
				<description>Refresh interval in seconds for values that change infrequently</description>
				<default>60</default>
			</parameter>
		</config-description>
	</thing-type>

	<channel-type id="modbus-state">
		<item-type>Number</item-type>
		<label>Operation State</label>
		<description>Current operational state of the wallbox</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true">
			<options>
				<option value="0">Starting</option>
				<option value="1">Not Ready</option>
				<option value="2">Ready</option>
				<option value="3">Charging</option>
				<option value="4">Error</option>
				<option value="5">Suspended</option>
			</options>
		</state>
	</channel-type>
	<channel-type id="modbus-cablestate" advanced="true">
		<item-type>Number</item-type>
		<label>Cable State</label>
		<description>State of the charging cable</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true">
			<options>
				<option value="0">No cable plugged</option>
				<option value="1">Plugged into wallbox</option>
				<option value="3">Plugged into wallbox and locked</option>
				<option value="5">Plugged into wallbox and vehicle, not locked</option>
				<option value="7">Plugged into wallbox and vehicle, locked</option>
			</options>
		</state>
	</channel-type>
	<channel-type id="modbus-errorcode" advanced="true">
		<item-type>Number</item-type>
		<label>Error Code</label>
		<description>Error code of the wallbox, if in error. 0 means no error</description>
		<tags>
			<tag>Alarm</tag>
		</tags>
		<state readOnly="true"></state>
	</channel-type>
	<channel-type id="modbus-current" advanced="true">
		<item-type>Number:ElectricCurrent</item-type>
		<label>Current</label>
		<description>Current</description>
		<tags>
			<tag>Measurement</tag>
			<tag>Current</tag>
		</tags>
		<state pattern="%.3f %unit%" readOnly="true"></state>
	</channel-type>
	<channel-type id="modbus-serial" advanced="true">
		<item-type>String</item-type>
		<label>Serial Number</label>
		<description>Serial number of the wallbox</description>
		<state readOnly="true"></state>
	</channel-type>
	<channel-type id="modbus-power">
		<item-type>Number:Power</item-type>
		<label>Power</label>
		<description>Active Power</description>
		<tags>
			<tag>Measurement</tag>
			<tag>Power</tag>
		</tags>
		<state pattern="%.3f %unit%" readOnly="true"></state>
	</channel-type>
	<channel-type id="modbus-totalenergy" advanced="true">
		<item-type>Number:Energy</item-type>
		<label>Energy Total</label>
		<description>Total energy consumption is added up after each completed charging session</description>
		<tags>
			<tag>Measurement</tag>
			<tag>Energy</tag>
		</tags>
		<state pattern="%.1f %unit%" readOnly="true"></state>
	</channel-type>
	<channel-type id="modbus-voltage" advanced="true">
		<item-type>Number:ElectricPotential</item-type>
		<label>Voltage</label>
		<description>Voltage</description>
		<tags>
			<tag>Measurement</tag>
			<tag>Voltage</tag>
		</tags>
		<state pattern="%d %unit%" readOnly="true"></state>
	</channel-type>
	<channel-type id="modbus-powerfactor" advanced="true">
		<item-type>Number:Dimensionless</item-type>
		<label>Power Factor</label>
		<description>Power factor (cosphi)</description>
		<state pattern="%.1f %%" readOnly="true"></state>
	</channel-type>
	<channel-type id="modbus-maxchargingcurrent" advanced="true">
		<item-type>Number:ElectricCurrent</item-type>
		<label>Max. Charging Current</label>
		<description>Maximum charging current currently offered to the vehicle</description>
		<tags>
			<tag>Measurement</tag>
			<tag>Current</tag>
		</tags>
		<state pattern="%.3f %unit%" readOnly="true"></state>
	</channel-type>
	<channel-type id="modbus-maxsupportedcurrent" advanced="true">
		<item-type>Number:ElectricCurrent</item-type>
		<label>Max. Supported Current</label>
		<description>Maximum current value that can be supported by the hardware of the wallbox</description>
		<tags>
			<tag>Measurement</tag>
			<tag>Current</tag>
		</tags>
		<state pattern="%.3f %unit%" readOnly="true"></state>
	</channel-type>
	<channel-type id="modbus-rfidtag" advanced="true">
		<item-type>String</item-type>
		<label>RFID Tag</label>
		<description>RFID Tag used for the last charging session (only available if enabled on the wallbox)</description>
		<state readOnly="true"></state>
	</channel-type>
	<channel-type id="modbus-sessionenergy" advanced="true">
		<item-type>Number:Energy</item-type>
		<label>Energy Session</label>
		<description>Energy transferred in the current charging session</description>
		<tags>
			<tag>Measurement</tag>
			<tag>Energy</tag>
		</tags>
		<state pattern="%.1f %unit%" readOnly="true"></state>
	</channel-type>
	<channel-type id="modbus-phaseswitchsource" advanced="true">
		<item-type>Number</item-type>
		<label>Phase Switching Source</label>
		<description>Source that is allowed to control the phase switching. "Toggle via UDP" can only be reported, not set,
			since the UDP and Modbus TCP interfaces cannot be enabled at the same time</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="false">
			<options>
				<option value="0">Phase switching deactivated</option>
				<option value="1">Toggle via OCPP</option>
				<option value="2">Toggle via REST API</option>
				<option value="3">Toggle via Modbus TCP</option>
				<option value="4">Toggle via UDP</option>
			</options>
		</state>
	</channel-type>
	<channel-type id="modbus-phaseswitchstate" advanced="true">
		<item-type>Number</item-type>
		<label>Phase Switching State</label>
		<description>Number of phases that are currently used</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true">
			<options>
				<option value="1">Single-phase charging</option>
				<option value="3">3-phase charging</option>
			</options>
		</state>
	</channel-type>
	<channel-type id="modbus-failsafecurrent" advanced="true">
		<item-type>Number:ElectricCurrent</item-type>
		<label>Failsafe Current</label>
		<description>Charging current to fall back to if the connection to the wallbox is lost</description>
		<tags>
			<tag>Setpoint</tag>
			<tag>Current</tag>
		</tags>
		<state pattern="%.3f %unit%" readOnly="false"></state>
	</channel-type>
	<channel-type id="modbus-failsafetimeout" advanced="true">
		<item-type>Number:Time</item-type>
		<label>Failsafe Timeout</label>
		<description>Timeout after which the failsafe current is applied if no command was received</description>
		<tags>
			<tag>Setpoint</tag>
		</tags>
		<state pattern="%d %unit%" readOnly="false"></state>
	</channel-type>
	<channel-type id="modbus-setchargingcurrent">
		<item-type>Number:ElectricCurrent</item-type>
		<label>Preset Current</label>
		<description>Sets the charging current the wallbox should offer to the vehicle</description>
		<tags>
			<tag>Setpoint</tag>
			<tag>Current</tag>
		</tags>
		<state pattern="%.3f %unit%" readOnly="false"></state>
	</channel-type>
	<channel-type id="modbus-setenergylimit" advanced="true">
		<item-type>Number:Energy</item-type>
		<label>Energy Limit</label>
		<description>Sets an energy limit for an already running or the next charging session</description>
		<tags>
			<tag>Setpoint</tag>
			<tag>Energy</tag>
		</tags>
		<state pattern="%.1f %unit%" readOnly="false"></state>
	</channel-type>
	<channel-type id="modbus-unlockplug" advanced="true">
		<item-type>Switch</item-type>
		<label>Unlock Plug</label>
		<description>Send ON to unlock the plug. The charging session must be stopped beforehand</description>
		<tags>
			<tag>Control</tag>
		</tags>
		<state readOnly="false"></state>
	</channel-type>
	<channel-type id="modbus-enableduser">
		<item-type>Switch</item-type>
		<label>Enabled (User)</label>
		<description>Enable or disable the wallbox</description>
		<tags>
			<tag>Switch</tag>
			<tag>Mode</tag>
		</tags>
		<state readOnly="false"></state>
	</channel-type>
	<channel-type id="modbus-triggerphaseswitch" advanced="true">
		<item-type>Number</item-type>
		<label>Trigger Phase Switch</label>
		<description>Triggers the phase switch. 0 = 1 phase, 1 = 3 phases</description>
		<tags>
			<tag>Control</tag>
		</tags>
		<state readOnly="false">
			<options>
				<option value="0">1 phase</option>
				<option value="1">3 phases</option>
			</options>
		</state>
	</channel-type>

</thing:thing-descriptions>

<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="keba"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<thing-type id="kecontact-rest">
		<label>KeContact (REST)</label>
		<description>A KEBA KeContact wallbox accessed through its authenticated REST API</description>
		<semantic-equipment-tag>EVSE</semantic-equipment-tag>
		<channels>
			<channel id="state" typeId="rest-state"/>
			<channel id="vehicle" typeId="plugvehicle"/>
			<channel id="session" typeId="rest-session"/>
			<channel id="error" typeId="rest-error"/>
			<channel id="current" typeId="current"/>
			<channel id="maxsupportedcurrent" typeId="maxcurrent">
				<label>Max. Supported Current</label>
			</channel>
			<channel id="power" typeId="power"/>
			<channel id="energy" typeId="totalenergy"/>
			<channel id="sessionstart" typeId="rest-session-start"/>
			<channel id="sessionduration" typeId="rest-session-duration"/>
			<channel id="sessionconsumption" typeId="rest-session-energy"/>
			<channel id="powerfactor" typeId="powerfactor"/>
			<channel id="temperature" typeId="rest-temperature"/>
			<channel id="I1" typeId="current">
				<label>Current Phase 1</label>
			</channel>
			<channel id="I2" typeId="current">
				<label>Current Phase 2</label>
			</channel>
			<channel id="I3" typeId="current">
				<label>Current Phase 3</label>
			</channel>
			<channel id="U1" typeId="voltage">
				<label>Voltage Phase 1</label>
			</channel>
			<channel id="U2" typeId="voltage">
				<label>Voltage Phase 2</label>
			</channel>
			<channel id="U3" typeId="voltage">
				<label>Voltage Phase 3</label>
			</channel>
			<channel id="input" typeId="rest-status">
				<label>REST X2 Active</label>
				<description>Raw x2active flag reported by the REST API. It is not assumed to be the UDP X1 enable-input signal.</description>
			</channel>
			<channel id="reserved" typeId="rest-status">
				<label>Reserved</label>
				<description>Whether the wallbox has an active reservation, reported by the REST reserved field.</description>
			</channel>
			<channel id="authon" typeId="rest-status">
				<label>Authentication Enabled</label>
			</channel>
			<channel id="externalmeter" typeId="rest-status">
				<label>External Meter</label>
			</channel>
			<channel id="maxphases" typeId="rest-number">
				<label>Maximum Phases</label>
			</channel>
			<channel id="phaseswitchstate" typeId="rest-phase-count"/>
			<channel id="phaseswitchsource" typeId="rest-phase-source"/>
			<channel id="phaseconfiguration" typeId="rest-phase-configuration"/>
			<channel id="dipswitchsettings" typeId="rest-dipswitch-settings"/>
			<channel id="dipswitchinterpretation" typeId="rest-dipswitch-interpretation"/>
			<channel id="enableduser" typeId="rest-enableduser"/>
			<channel id="permanentlylocked" typeId="rest-permanently-locked"/>
			<channel id="unlock" typeId="rest-command">
				<label>Unlock</label>
			</channel>
			<channel id="start" typeId="rest-command">
				<label>Start Charging</label>
			</channel>
			<channel id="stop" typeId="rest-command">
				<label>Stop Charging</label>
			</channel>
			<channel id="triggerphaseswitch" typeId="rest-command">
				<label>Toggle Phases</label>
			</channel>
			<channel id="reboot" typeId="rest-command">
				<label>Reboot</label>
			</channel>
		</channels>
		<config-description>
			<parameter name="baseUrl" type="text" required="true">
				<context>url</context>
				<label>REST API URL</label>
				<description>Base URL of the KEBA REST API, for example https://192.168.0.10:8443</description>
				<default>https://</default>
			</parameter>
			<parameter name="username" type="text" required="true">
				<label>Username</label>
				<default>admin</default>
			</parameter>
			<parameter name="password" type="text" required="true">
				<context>password</context>
				<label>Password</label>
			</parameter>
			<parameter name="serialNumber" type="text" required="false">
				<label>Wallbox Serial Number</label>
				<description>Optional serial number. Leave empty to read it from the REST API; specify it to select a slave wallbox
					in a master/slave setup</description>
			</parameter>
			<parameter name="refreshInterval" type="integer" min="5" unit="s">
				<label>Refresh Interval</label>
				<description>REST polling interval in seconds</description>
				<default>10</default>
			</parameter>
			<parameter name="verifyCertificate" type="boolean">
				<label>Verify TLS Certificate</label>
				<description>Verify that the wallbox certificate is trusted by openHAB and matches the configured host</description>
				<default>false</default>
			</parameter>
		</config-description>
	</thing-type>

	<channel-type id="rest-state">
		<item-type>String</item-type>
		<label>Operation State</label>
		<description>Current operational state of the wallbox</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="rest-session">
		<item-type>Switch</item-type>
		<label>Session Active</label>
		<description>Whether a charging session is active</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="rest-session-start" advanced="true">
		<item-type>DateTime</item-type>
		<label>Session Start</label>
		<description>Start time of the latest charging session</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="rest-session-duration" advanced="true">
		<item-type>Number:Time</item-type>
		<label>Session Duration</label>
		<description>Duration of the latest charging session</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state pattern="%d %unit%" readOnly="true"/>
	</channel-type>
	<channel-type id="rest-session-energy" advanced="true">
		<item-type>Number:Energy</item-type>
		<label>Session Energy</label>
		<description>Energy consumed during the latest charging session</description>
		<tags>
			<tag>Measurement</tag>
			<tag>Energy</tag>
		</tags>
		<state pattern="%.1f %unit%" readOnly="true"/>
	</channel-type>
	<channel-type id="rest-error">
		<item-type>String</item-type>
		<label>Error</label>
		<description>Wallbox error</description>
		<tags>
			<tag>Alarm</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="rest-temperature" advanced="true">
		<item-type>Number:Temperature</item-type>
		<label>Temperature</label>
		<description>Internal wallbox temperature</description>
		<tags>
			<tag>Measurement</tag>
			<tag>Temperature</tag>
		</tags>
		<state pattern="%.2f %unit%" readOnly="true"/>
	</channel-type>
	<channel-type id="rest-status" advanced="true">
		<item-type>Switch</item-type>
		<label>Status</label>
		<description>Wallbox status</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="rest-number" advanced="true">
		<item-type>Number</item-type>
		<label>Value</label>
		<description>Wallbox value</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="rest-phase-count" advanced="true">
		<item-type>Number</item-type>
		<label>Phase Switching State</label>
		<description>Number of phases currently used</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true">
			<options>
				<option value="1">Single-phase charging</option>
				<option value="3">3-phase charging</option>
			</options>
		</state>
	</channel-type>
	<channel-type id="rest-phase-configuration" advanced="true">
		<item-type>String</item-type>
		<label>Phase Configuration</label>
		<description>Configured phase order</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="rest-phase-source" advanced="true">
		<item-type>Number</item-type>
		<label>Phase Switching Source</label>
		<description>Communication channel allowed to control phase switching</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="false">
			<options>
				<option value="0">Phase switching deactivated</option>
				<option value="1">Toggle via OCPP profiles</option>
				<option value="2">Toggle via REST API direct control</option>
				<option value="3">Toggle via Modbus TCP</option>
				<option value="4">Toggle via UDP</option>
			</options>
		</state>
	</channel-type>
	<channel-type id="rest-dipswitch-settings" advanced="true">
		<item-type>String</item-type>
		<label>DIP Switch Settings</label>
		<description>Raw JSON array of DIP switch values; null entries are preserved</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="rest-dipswitch-interpretation" advanced="true">
		<item-type>String</item-type>
		<label>DIP Switch Interpretation</label>
		<description>Named DIP switch settings represented as a JSON object</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="rest-enableduser">
		<item-type>Switch</item-type>
		<label>Enabled (User)</label>
		<description>Make the wallbox available or unavailable for charging</description>
		<tags>
			<tag>Switch</tag>
			<tag>Mode</tag>
		</tags>
		<state readOnly="false"/>
	</channel-type>
	<channel-type id="rest-permanently-locked" advanced="true">
		<item-type>Switch</item-type>
		<label>Permanently Locked</label>
		<description>Enable or disable permanent locking</description>
		<tags>
			<tag>Switch</tag>
			<tag>Mode</tag>
		</tags>
		<state readOnly="false"/>
	</channel-type>
	<channel-type id="rest-command">
		<item-type>Switch</item-type>
		<label>REST Command</label>
		<description>Send ON to execute this one-shot REST command</description>
		<tags>
			<tag>Control</tag>
		</tags>
		<state readOnly="false"/>
	</channel-type>
</thing:thing-descriptions>

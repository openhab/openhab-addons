				<option value="20009">DC current limitation</option>
				<option value="20010">AC current limitation</option>
				<option value="20011">Test mode</option>
				<option value="20012">Remote controlled</option>
				<option value="20013">Restart delay</option>
				<option value="20014">External limitation</option>
				<option value="20015">Frequency limitation</option>
				<option value="20016">Restart limitation</option>
				<option value="20017">Booting</option>
				<option value="20018">Insufficient boot power</option>
				<option value="20019">Insufficient power</option>
				<option value="20021">Uninitialized</option>
				<option value="20022">Disabled</option>
				<option value="20023">Idle</option>
				<option value="20024">Power unit not ready</option>
				<option value="20050">Programming firmware</option>
				<option value="20105">DC insulation fault</option>
				<option value="20106">DC insulation fault</option>
				<option value="20109">DC voltage too high</option>
				<option value="20114">Residual current too high</option>
				<option value="20115">No mains</option>
				<option value="20116">Mains frequency too high</option>
				<option value="20117">Mains frequency too low</option>
				<option value="20118">Mains error</option>
				<option value="20119">Mains voltage 10 min average too high</option>
				<option value="20122">Mains voltage too high</option>
				<option value="20123">Mains voltage too low</option>
				<option value="20126">Error external input 1</option>
				<option value="20127">Error external input 2</option>
				<option value="20129">Incorrect phase rotation</option>
				<option value="20131">Main switch off</option>
				<option value="20145">Mains frequency change rate too high</option>
				<option value="20150">Residual current step too high</option>

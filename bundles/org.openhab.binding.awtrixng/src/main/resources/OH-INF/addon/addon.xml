<?xml version="1.0" encoding="UTF-8"?>
<addon:addon id="awtrixng" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:addon="https://openhab.org/schemas/addon/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/addon/v1.0.0 https://openhab.org/schemas/addon-1.0.0.xsd">

	<type>binding</type>
	<name>AWTRIX NG Binding</name>
	<description>Controls LED matrix clocks that run the AWTRIX NG firmware over MQTT: settings, indicators, apps,
		notifications, sounds and the live screen</description>
	<connection>local</connection>

	<discovery-methods>
		<discovery-method>
			<service-type>mdns</service-type>
			<discovery-parameters>
				<discovery-parameter>
					<name>mdnsServiceType</name>
					<value>_awtrixng._tcp.local.</value>
				</discovery-parameter>
			</discovery-parameters>
		</discovery-method>
	</discovery-methods>

</addon:addon>

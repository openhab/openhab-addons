					{
						"command": "set_power",
						"parameterType": "ONOFF",
						"parameters": [
							"on",
							"smooth",
							500,
							"$value$"
						],
						"condition": {
							"name": "matchValue",
							"parameters": [
								{
									"matchValue": "ON",
									"returnValue": 5
								},
								{
									"matchValue": "OFF",
									"returnValue": 1
								}
							]
						}
					}
				],
				"category": "light",
				"tags": [
					"Control",
					"Mode"
				],

{
	"deviceMapping": {
		"id": [
			"lumi.gateway.v1",
			"lumi.gateway.v2",
			"lumi.gateway.v3"
		],
		"propertyMethod": "get_prop",
		"maxProperties": 4,
		"channels": [
			{
				"property": "",
				"friendlyName": "Enable Telnet",
				"channel": "telnetEnable",
				"type": "Switch",
				"refresh": false,
				"actions": [
					{
						"command": "enable_telnet_service",
						"parameterType": "EMPTY"
					}
				],
				"readmeComment": "Access the device with telnet to further unlock developer mode. See forum"
			},
			{
				"property": "doorbell_volume",
				"friendlyName": "Doorbell Volume",
				"channel": "doorbellVol",
				"type": "Number",
				"refresh": true,
				"actions": [
					{
						"command": "set_doorbell_volume",
						"parameterType": "NUMBER"
					}
				]
			},
			{
				"property": "gateway_volume",
				"friendlyName": "Gateway Volume",
				"channel": "gatewayVol",
				"type": "Number",
				"refresh": true,
				"actions": [
					{
						"command": "set_gateway_volume",
						"parameterType": "NUMBER"
					}
				]
			},
			{
				"property": "alarming_volume",
				"friendlyName": "Alarming Volume",
				"channel": "alarmingVol",
				"type": "Number",
				"refresh": true,
				"actions": [
					{
						"command": "set_alarming_volume",
						"parameterType": "NUMBER"
					}
				]
			},
			{
				"property": "doorbell_push",
				"friendlyName": "Doorbell Push",
				"channel": "doorbellPush",
				"type": "String",
				"refresh": true,
				"actions": [
					{
						"command": "set_doorbell_push",
						"parameterType": "STRING"
					}
				]
			},
			{
				"property": "",
				"friendlyName": "FM Radio Power",
				"channel": "fmPower",
				"type": "Switch",
				"refresh": false,
				"actions": [
					{
						"command": "play_fm",
						"parameterType": "ONOFF"
					}
				],
				"category": "switch",
				"tags": [
					"Switch",
					"Power"
				],
				"readmeComment": "Starts or stops the FM (internet) radio. Experimental, please provide feedback on the community forum."
			},
			{
				"property": "current_volume",
				"friendlyName": "FM Radio Volume",
				"channel": "fmVolume",
				"type": "Dimmer",
				"refresh": true,
				"customRefreshCommand": "get_prop_fm[]",
				"transformation": "getJsonElement-current_volume",
				"actions": [
					{
						"command": "set_fm_volume",
						"parameterType": "NUMBER"
					}
				],
				"category": "soundvolume",
				"tags": [
					"Control",
					"SoundVolume"
				],
				"readmeComment": "Experimental, please provide feedback on the community forum."
			},
			{
				"property": "current_status",
				"friendlyName": "FM Radio Status",
				"channel": "fmStatus",
				"type": "String",
				"stateDescription": {
					"readOnly": true,
					"options": [
						{
							"value": "run",
							"label": "Playing"
						},
						{
							"value": "pause",
							"label": "Paused"
						}
					]
				},
				"refresh": true,
				"customRefreshCommand": "get_prop_fm",
				"transformation": "getJsonElement-current_status",
				"actions": [],
				"category": "player",
				"tags": [
					"Status",
					"MediaControl"
				],
				"readmeComment": "Experimental, please provide feedback on the community forum."
			},
			{
				"property": "current_program",
				"friendlyName": "FM Radio Program",
				"channel": "fmProgram",
				"type": "Number",
				"stateDescription": {
					"pattern": "%d",
					"readOnly": true
				},
				"refresh": true,
				"customRefreshCommand": "get_prop_fm []",
				"transformation": "getJsonElement-current_program",
				"actions": [],
				"tags": [
					"Status",
					"Channel"
				],
				"readmeComment": "Id of the current radio program. Experimental, please provide feedback on the community forum."
			}
		],
		"readmeComment": "Used to control the gateway itself. Use the mihome binding to control devices connected to the Xiaomi gateway if you have the developer key. Otherwise this binding provides experimental support for lumi subdevices",
		"experimental": true
	}
}

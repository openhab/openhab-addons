			{
				"property": "",
				"friendlyName": "Upper Basket - Start Cooking With Settings",
				"channel": "upper_start_cook",
				"type": "String",
				"refresh": false,
				"actions": [
					{
						"command": "action",
						"parameterType": "JSON",
						"siid": 6,
						"aiid": 5
					}
				],
				"readmeComment": "Starts cooking in the upper basket with a JSON list of 7 values: time (minutes), temperature (degrees Celsius), recipe id, keep warm after cooking (true or false), scheduled start time (minutes, 0 starts now), both baskets (0 this basket only, 1 both baskets), turn food reminder (true or false). The recipe id is `M11` for manual cooking, other `M` ids for the device presets or `C` plus the recipeID of a cloud recipe. For both baskets the Mi Home app sends the same list to the upper and the lower basket. Example manual cooking 15 minutes at 180 degrees: `[15,180,\"M11\",false,0,0,false]`."
			},

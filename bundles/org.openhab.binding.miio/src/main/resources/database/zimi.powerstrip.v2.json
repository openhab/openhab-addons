				"refresh": true,
				"actions": [
					{
						"command": "set_lowpower_autooff",
						"parameterType": "NUMBER",
						"parameters": [
							{
								"lp_autooff": "$lp_autooff$",
								"lp_autooff_delay": "$value$",
								"lp_threshold": "$lp_threshold$"

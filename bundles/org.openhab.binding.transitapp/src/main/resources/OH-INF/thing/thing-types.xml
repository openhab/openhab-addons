<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="transitapp"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">
	<bridge-type id="bridge">
		<label>@text/thing-type.transitapp.bridge.label</label>
		<description>@text/thing-type.transitapp.bridge.description</description>
		<config-description>
			<parameter name="apiKey" type="text" required="true">
				<context>password</context>
				<label>@text/thing-type.config.transitapp.bridge.apiKey.label</label>
				<description>@text/thing-type.config.transitapp.bridge.apiKey.description</description>
			</parameter>
			<parameter name="cacheTimeMs" type="integer" min="5000" max="300000">
				<label>@text/thing-type.config.transitapp.bridge.cacheTimeMs.label</label>
				<description>@text/thing-type.config.transitapp.bridge.cacheTimeMs.description</description>
				<default>30000</default>
				<advanced>true</advanced>
			</parameter>
			<parameter name="retryAfterSeconds" type="integer" min="1" max="600">
				<label>@text/thing-type.config.transitapp.bridge.retryAfterSeconds.label</label>
				<description>@text/thing-type.config.transitapp.bridge.retryAfterSeconds.description</description>
				<default>60</default>
				<advanced>true</advanced>
			</parameter>
			<parameter name="maxDepartures" type="integer" min="1" max="10">
				<label>@text/thing-type.config.transitapp.bridge.maxDepartures.label</label>
				<description>@text/thing-type.config.transitapp.bridge.maxDepartures.description</description>
				<default>10</default>
				<advanced>true</advanced>
			</parameter>
		</config-description>
	</bridge-type>
	<thing-type id="stop">
		<supported-bridge-type-refs>
			<bridge-type-ref id="bridge"/>
		</supported-bridge-type-refs>
		<label>@text/thing-type.transitapp.stop.label</label>
		<description>@text/thing-type.transitapp.stop.description</description>
		<channel-groups>
			<channel-group id="depart1" typeId="departure-group"/>
			<channel-group id="depart2" typeId="departure-group"/>
			<channel-group id="depart3" typeId="departure-group"/>
			<channel-group id="depart4" typeId="departure-group"/>
			<channel-group id="depart5" typeId="departure-group"/>
			<channel-group id="depart6" typeId="departure-group"/>
			<channel-group id="depart7" typeId="departure-group"/>
			<channel-group id="depart8" typeId="departure-group"/>
			<channel-group id="depart9" typeId="departure-group"/>
			<channel-group id="depart10" typeId="departure-group"/>
		</channel-groups>
		<config-description>
			<parameter name="globalStopId" type="text" required="true">
				<label>@text/thing-type.config.transitapp.stop.globalStopId.label</label>
				<description>@text/thing-type.config.transitapp.stop.globalStopId.description</description>
			</parameter>
			<parameter name="refreshInterval" type="integer" min="30">
				<label>@text/thing-type.config.transitapp.stop.refreshInterval.label</label>
				<description>@text/thing-type.config.transitapp.stop.refreshInterval.description</description>
				<default>60</default>
			</parameter>
		</config-description>
	</thing-type>
	<thing-type id="routedetails">
		<supported-bridge-type-refs>
			<bridge-type-ref id="bridge"/>
		</supported-bridge-type-refs>
		<label>@text/thing-type.transitapp.routedetails.label</label>
		<description>@text/thing-type.transitapp.routedetails.description</description>
		<channel-groups>
			<channel-group id="route" typeId="route-group"/>
		</channel-groups>
		<config-description>
			<parameter name="routeId" type="text" required="true">
				<label>@text/thing-type.config.transitapp.routedetails.routeId.label</label>
				<description>@text/thing-type.config.transitapp.routedetails.routeId.description</description>
			</parameter>
			<parameter name="refreshInterval" type="integer" min="30">
				<label>@text/thing-type.config.transitapp.routedetails.refreshInterval.label</label>
				<description>@text/thing-type.config.transitapp.routedetails.refreshInterval.description</description>
				<default>300</default>
			</parameter>
		</config-description>
	</thing-type>
	<thing-type id="tripdetails">
		<supported-bridge-type-refs>
			<bridge-type-ref id="bridge"/>
		</supported-bridge-type-refs>
		<label>@text/thing-type.transitapp.tripdetails.label</label>
		<description>@text/thing-type.transitapp.tripdetails.description</description>
		<channel-groups>
			<channel-group id="trip" typeId="trip-group"/>
			<channel-group id="stop1" typeId="stop-group"/>
			<channel-group id="stop2" typeId="stop-group"/>
			<channel-group id="stop3" typeId="stop-group"/>
			<channel-group id="stop4" typeId="stop-group"/>
			<channel-group id="stop5" typeId="stop-group"/>
			<channel-group id="stop6" typeId="stop-group"/>
			<channel-group id="stop7" typeId="stop-group"/>
			<channel-group id="stop8" typeId="stop-group"/>
			<channel-group id="stop9" typeId="stop-group"/>
			<channel-group id="stop10" typeId="stop-group"/>
		</channel-groups>
		<config-description>
			<parameter name="tripSearchKey" type="text" required="true">
				<label>@text/thing-type.config.transitapp.tripdetails.tripSearchKey.label</label>
				<description>@text/thing-type.config.transitapp.tripdetails.tripSearchKey.description</description>
			</parameter>
			<parameter name="refreshInterval" type="integer" min="30">
				<label>@text/thing-type.config.transitapp.tripdetails.refreshInterval.label</label>
				<description>@text/thing-type.config.transitapp.tripdetails.refreshInterval.description</description>
				<default>60</default>
			</parameter>
			<parameter name="targetStopId" type="text" required="false">
				<label>@text/thing-type.config.transitapp.tripdetails.targetStopId.label</label>
				<description>@text/thing-type.config.transitapp.tripdetails.targetStopId.description</description>
			</parameter>
		</config-description>
	</thing-type>
	<channel-group-type id="departure-group">
		<label>@text/channel-group-type.transitapp.departure-group.label</label>
		<channels>
			<channel id="route-long-name" typeId="route-long-name"/>
			<channel id="route-short-name" typeId="route-short-name"/>
			<channel id="departure-time" typeId="departure-time"/>
			<channel id="is-cancelled" typeId="is-cancelled"/>
			<channel id="minutes-until-departure" typeId="minutes-until-departure"/>
			<channel id="delay-minutes" typeId="delay-minutes"/>
			<channel id="platform" typeId="platform"/>
			<channel id="wheelchair-accessible" typeId="wheelchair-accessible"/>
			<channel id="occupancy" typeId="occupancy"/>
		</channels>
	</channel-group-type>
	<channel-group-type id="route-group">
		<label>Route Details</label>
		<channels>
			<channel id="route-long-name" typeId="route-long-name"/>
			<channel id="route-short-name" typeId="route-short-name"/>
			<channel id="route-color" typeId="route-color"/>
			<channel id="active-alerts-count" typeId="active-alerts-count"/>
		</channels>
	</channel-group-type>
	<channel-group-type id="trip-group">
		<label>Trip Details</label>
		<channels>
			<channel id="route-short-name" typeId="route-short-name"/>
			<channel id="time-to-target" typeId="time-to-target"/>
		</channels>
	</channel-group-type>
	<channel-group-type id="stop-group">
		<label>Upcoming Stop</label>
		<channels>
			<channel id="stop-name" typeId="stop-name"/>
			<channel id="minutes-until-departure" typeId="minutes-until-departure"/>
		</channels>
	</channel-group-type>
	<channel-type id="route-long-name">
		<item-type>String</item-type>
		<label>@text/channel-type.transitapp.route-long-name.label</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="route-short-name">
		<item-type>String</item-type>
		<label>@text/channel-type.transitapp.route-short-name.label</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="departure-time">
		<item-type>DateTime</item-type>
		<label>@text/channel-type.transitapp.departure-time.label</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="is-cancelled">
		<item-type>Switch</item-type>
		<label>Is Cancelled</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="route-color">
		<item-type>String</item-type>
		<label>@text/channel-type.transitapp.route-color.label</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="stop-name">
		<item-type>String</item-type>
		<label>@text/channel-type.transitapp.stop-name.label</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="minutes-until-departure">
		<item-type>Number:Time</item-type>
		<label>@text/channel-type.transitapp.minutes-until-departure.label</label>
		<state readOnly="true" pattern="%d %unit%"/>
	</channel-type>
	<channel-type id="delay-minutes">
		<item-type>Number:Time</item-type>
		<label>@text/channel-type.transitapp.delay-minutes.label</label>
		<state readOnly="true" pattern="%d %unit%"/>
	</channel-type>
	<channel-type id="platform">
		<item-type>String</item-type>
		<label>Platform / Track</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="active-alerts-count">
		<item-type>Number</item-type>
		<label>Active Alerts Count</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="time-to-target">
		<item-type>Number:Time</item-type>
		<label>@text/channel-type.transitapp.time-to-target.label</label>
		<description>Live countdown to the configured target destination stop</description>
		<state readOnly="true" pattern="%d %unit%"/>
	</channel-type>
	<channel-type id="wheelchair-accessible">
		<item-type>Switch</item-type>
		<label>@text/channel-type.transitapp.wheelchair-accessible.label</label>
		<description>Indicates whether the departure is wheelchair accessible</description>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="occupancy">
		<item-type>String</item-type>
		<label>@text/channel-type.transitapp.occupancy.label</label>
		<description>Current occupancy status of the vehicle</description>
		<state readOnly="true"/>
	</channel-type>
</thing:thing-descriptions>

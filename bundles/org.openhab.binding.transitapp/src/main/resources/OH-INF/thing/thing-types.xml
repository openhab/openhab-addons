<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="transitapp"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">
	<bridge-type id="bridge">
		<label>TransitApp Bridge</label>
		<description>Bridge to connect to Transit API</description>
		<config-description>
			<parameter name="apiKey" type="text" required="true">
				<context>password</context>
				<label>API Key</label>
				<description>Your Transit API key.</description>
			</parameter>
		</config-description>
	</bridge-type>
	<thing-type id="stop">
		<supported-bridge-type-refs>
			<bridge-type-ref id="bridge"/>
		</supported-bridge-type-refs>
		<label>Transit Stop</label>
		<description>Transit Stop Thing with dynamic departures</description>
		<channel-groups>
			<channel-group id="depart1" typeId="departure-group"/>
			<channel-group id="depart2" typeId="departure-group"/>
			<channel-group id="depart3" typeId="departure-group"/>
			<channel-group id="depart4" typeId="departure-group"/>
			<channel-group id="depart5" typeId="departure-group"/>
			<channel-group id="depart6" typeId="departure-group"/>
			<channel-group id="depart7" typeId="departure-group"/>
			<channel-group id="depart8" typeId="departure-group"/>
			<channel-group id="depart9" typeId="departure-group"/>
			<channel-group id="depart10" typeId="departure-group"/>
		</channel-groups>
		<config-description>
			<parameter name="globalStopId" type="text" required="true">
				<label>Global Stop ID</label>
				<description>The global stop ID for Transit API.</description>
			</parameter>
			<parameter name="refreshInterval" type="integer" min="30">
				<label>Refresh Interval</label>
				<description>Time in seconds between updates.</description>
				<default>60</default>
			</parameter>
		</config-description>
	</thing-type>
	<thing-type id="routedetails">
		<supported-bridge-type-refs>
			<bridge-type-ref id="bridge"/>
		</supported-bridge-type-refs>
		<label>Transit Route Details</label>
		<description>Details and information about a specific transit route.</description>
		<channel-groups>
			<channel-group id="route" typeId="route-group"/>
		</channel-groups>
		<config-description>
			<parameter name="routeId" type="text" required="true">
				<label>Route ID</label>
				<description>The unique identifier for the route.</description>
			</parameter>
			<parameter name="refreshInterval" type="integer" min="30">
				<label>Refresh Interval</label>
				<description>Time in seconds between updates.</description>
				<default>300</default>
			</parameter>
		</config-description>
	</thing-type>
	<thing-type id="tripdetails">
		<supported-bridge-type-refs>
			<bridge-type-ref id="bridge"/>
		</supported-bridge-type-refs>
		<label>Transit Trip Details</label>
		<description>Real-time details and schedule for a specific transit trip.</description>
		<channel-groups>
			<channel-group id="trip" typeId="trip-group"/>
			<channel-group id="stop1" typeId="stop-group"/>
			<channel-group id="stop2" typeId="stop-group"/>
			<channel-group id="stop3" typeId="stop-group"/>
			<channel-group id="stop4" typeId="stop-group"/>
			<channel-group id="stop5" typeId="stop-group"/>
			<channel-group id="stop6" typeId="stop-group"/>
			<channel-group id="stop7" typeId="stop-group"/>
			<channel-group id="stop8" typeId="stop-group"/>
			<channel-group id="stop9" typeId="stop-group"/>
			<channel-group id="stop10" typeId="stop-group"/>
		</channel-groups>
		<config-description>
			<parameter name="tripId" type="text" required="true">
				<label>Trip Search Key</label>
				<description>The trip search key used by the Transit API.</description>
			</parameter>
			<parameter name="refreshInterval" type="integer" min="30">
				<label>Refresh Interval</label>
				<description>Time in seconds between updates.</description>
				<default>60</default>
			</parameter>
			<parameter name="targetStopId" type="text" required="false">
				<label>Target Stop ID</label>
				<description>Destination stop ID to calculate the time-to-target countdown.</description>
			</parameter>
		</config-description>
	</thing-type>
	<channel-group-type id="departure-group">
		<label>Departure</label>
		<channels>
			<channel id="route-long-name" typeId="route-long-name"/>
			<channel id="route-short-name" typeId="route-short-name"/>
			<channel id="departure-time" typeId="departure-time"/>
			<channel id="is-cancelled" typeId="is-cancelled"/>
			<channel id="minutes-until-departure" typeId="minutes-until-departure"/>
			<channel id="delay-minutes" typeId="delay-minutes"/>
			<channel id="platform" typeId="platform"/>
			<channel id="wheelchair-accessible" typeId="wheelchair-accessible"/>
			<channel id="occupancy" typeId="occupancy"/>
		</channels>
	</channel-group-type>
	<channel-group-type id="route-group">
		<label>Route Details</label>
		<channels>
			<channel id="route-long-name" typeId="route-long-name"/>
			<channel id="route-short-name" typeId="route-short-name"/>
			<channel id="route-color" typeId="route-color"/>
			<channel id="active-alerts-count" typeId="active-alerts-count"/>
		</channels>
	</channel-group-type>
	<channel-group-type id="trip-group">
		<label>Trip Details</label>
		<channels>
			<channel id="trip-headsign" typeId="trip-headsign"/>
			<channel id="route-short-name" typeId="route-short-name"/>
			<channel id="location" typeId="location"/>
			<channel id="time-to-target" typeId="time-to-target"/>
		</channels>
	</channel-group-type>
	<channel-group-type id="stop-group">
		<label>Upcoming Stop</label>
		<channels>
			<channel id="stop-name" typeId="stop-name"/>
			<channel id="minutes-until-departure" typeId="minutes-until-departure"/>
		</channels>
	</channel-group-type>
	<channel-type id="route-long-name">
		<item-type>String</item-type>
		<label>Route Long Name</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="route-short-name">
		<item-type>String</item-type>
		<label>Route Short Name</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="agency-name">
		<item-type>String</item-type>
		<label>Agency Name</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="trip-headsign">
		<item-type>String</item-type>
		<label>Trip Headsign</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="trip-status">
		<item-type>String</item-type>
		<label>Trip Status</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="departure-time">
		<item-type>DateTime</item-type>
		<label>Departure Time</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="is-cancelled">
		<item-type>Switch</item-type>
		<label>Is Cancelled</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="route-color">
		<item-type>String</item-type>
		<label>Route Color</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="route-text-color">
		<item-type>String</item-type>
		<label>Route Text Color</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="route-network-name">
		<item-type>String</item-type>
		<label>Route Network Name</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="mode-name">
		<item-type>String</item-type>
		<label>Mode Name</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="vehicle-name">
		<item-type>String</item-type>
		<label>Vehicle Name</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="rt-trip-id">
		<item-type>String</item-type>
		<label>Real-Time Trip ID</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="stop-name">
		<item-type>String</item-type>
		<label>Stop Name</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="alert-title">
		<item-type>String</item-type>
		<label>Alert Title</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="alert-description">
		<item-type>String</item-type>
		<label>Alert Description</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="alert-severity">
		<item-type>String</item-type>
		<label>Alert Severity</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="minutes-until-departure">
		<item-type>Number:Time</item-type>
		<label>Minutes Until Departure</label>
		<state readOnly="true" pattern="%d %unit%"/>
	</channel-type>
	<channel-type id="delay-minutes">
		<item-type>Number:Time</item-type>
		<label>Delay</label>
		<state readOnly="true" pattern="%d %unit%"/>
	</channel-type>
	<channel-type id="platform">
		<item-type>String</item-type>
		<label>Platform / Track</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="active-alerts-count">
		<item-type>Number</item-type>
		<label>Active Alerts Count</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="location">
		<item-type>Location</item-type>
		<label>Vehicle Location</label>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="time-to-target">
		<item-type>Number:Time</item-type>
		<label>Time to Target</label>
		<description>Live countdown to the configured target destination stop</description>
		<state readOnly="true" pattern="%d %unit%"/>
	</channel-type>
	<channel-type id="url">
		<item-type>String</item-type>
		<label>Route Schedule URL</label>
		<description>Web link to route schedule or information</description>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="wheelchair-accessible">
		<item-type>Switch</item-type>
		<label>Wheelchair Accessible</label>
		<description>Indicates whether the departure is wheelchair accessible</description>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="occupancy">
		<item-type>String</item-type>
		<label>Occupancy</label>
		<description>Current occupancy status of the vehicle</description>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="bikes-allowed">
		<item-type>Switch</item-type>
		<label>Bikes Allowed</label>
		<description>Indicates whether bicycles are allowed on this vehicle</description>
		<state readOnly="true"/>
	</channel-type>
</thing:thing-descriptions>

<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="transitapp"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<bridge-type id="bridge">
		<label>@text/thing-type.transitapp.bridge.label</label>
		<description>@text/thing-type.transitapp.bridge.description</description>
		<config-description>
			<parameter name="apiKey" type="text" required="true">
				<label>@text/config.apiKey.label</label>
				<description>@text/config.apiKey.description</description>
			</parameter>
		</config-description>
	</bridge-type>

	<thing-type id="stop">
		<supported-bridge-type-refs>
			<bridge-type-ref id="bridge"/>
		</supported-bridge-type-refs>
		<label>@text/thing-type.transitapp.stop.label</label>
		<description>@text/thing-type.transitapp.stop.description</description>
		<channel-groups>
			<channel-group id="depart1" typeId="departureGroup"/>
			<channel-group id="depart2" typeId="departureGroup"/>
			<channel-group id="depart3" typeId="departureGroup"/>
		</channel-groups>
		<config-description>
			<parameter name="globalStopId" type="text" required="true">
				<label>@text/config.globalStopId.label</label>
				<description>@text/config.globalStopId.description</description>
			</parameter>
			<parameter name="refreshInterval" type="integer" min="30">
				<label>@text/config.refreshInterval.label</label>
				<description>@text/config.refreshInterval.description</description>
				<default>60</default>
			</parameter>
		</config-description>
	</thing-type>

	<thing-type id="routedetails">
		<supported-bridge-type-refs>
			<bridge-type-ref id="bridge"/>
		</supported-bridge-type-refs>
		<label>@text/thing-type.transitapp.routedetails.label</label>
		<description>@text/thing-type.transitapp.routedetails.description</description>
		<channel-groups>
			<channel-group id="route" typeId="routeGroup"/>
		</channel-groups>
		<config-description>
			<parameter name="routeId" type="text" required="true">
				<label>@text/config.routeId.label</label>
				<description>@text/config.routeId.description</description>
			</parameter>
			<parameter name="includeNextDeparture" type="boolean" required="false">
				<label>@text/config.includeNextDeparture.label</label>
				<description>@text/config.includeNextDeparture.description</description>
				<default>false</default>
			</parameter>
			<parameter name="stopDetailed" type="boolean" required="false">
				<label>@text/config.stopDetailed.label</label>
				<description>@text/config.stopDetailed.description</description>
				<default>false</default>
			</parameter>
			<parameter name="locale" type="text" required="false">
				<label>@text/config.locale.label</label>
				<description>@text/config.locale.description</description>
			</parameter>
			<parameter name="refreshInterval" type="integer" min="30">
				<label>@text/config.refreshInterval.label</label>
				<description>@text/config.refreshInterval.description</description>
				<default>300</default>
			</parameter>
		</config-description>
	</thing-type>

	<thing-type id="tripdetails">
		<supported-bridge-type-refs>
			<bridge-type-ref id="bridge"/>
		</supported-bridge-type-refs>
		<label>@text/thing-type.transitapp.tripdetails.label</label>
		<description>@text/thing-type.transitapp.tripdetails.description</description>
		<channel-groups>
			<channel-group id="trip1" typeId="tripGroup"/>
			<channel-group id="stop1" typeId="stopGroup"/>
			<channel-group id="stop2" typeId="stopGroup"/>
			<channel-group id="stop3" typeId="stopGroup"/>
			<channel-group id="stop4" typeId="stopGroup"/>
			<channel-group id="stop5" typeId="stopGroup"/>
		</channel-groups>
		<config-description>
			<parameter name="tripId" type="text" required="true">
				<label>@text/config.tripId.label</label>
				<description>@text/config.tripId.description</description>
			</parameter>
			<parameter name="includeContinuation" type="boolean" required="false">
				<label>@text/config.includeContinuation.label</label>
				<description>@text/config.includeContinuation.description</description>
				<default>false</default>
			</parameter>
			<parameter name="locale" type="text" required="false">
				<label>@text/config.locale.label</label>
				<description>@text/config.locale.description</description>
			</parameter>
			<parameter name="refreshInterval" type="integer" min="30">
				<label>@text/config.refreshInterval.label</label>
				<description>@text/config.refreshInterval.description</description>
				<default>60</default>
			</parameter>
			<parameter name="targetStopId" type="text" required="false">
				<label>@text/config.targetStopId.label</label>
				<description>@text/config.targetStopId.description</description>
			</parameter>
		</config-description>
	</thing-type>

	<channel-group-type id="departureGroup">
		<label>@text/group.departure.label</label>
		<channels>
			<channel id="routeLongName" typeId="routeLongName"/>
			<channel id="routeShortName" typeId="routeShortName"/>
			<channel id="departureTime" typeId="departureTime"/>
			<channel id="isCancelled" typeId="isCancelled"/>
			<channel id="minutesUntilDeparture" typeId="minutesUntilDeparture"/>
			<channel id="delayMinutes" typeId="delayMinutes"/>
			<channel id="platform" typeId="platform"/>
			<channel id="wheelchairAccessible" typeId="isCancelled"/>
			<channel id="occupancy" typeId="routeShortName"/>
		</channels>
	</channel-group-type>

	<channel-group-type id="routeGroup">
		<label>@text/group.routeDetails.label</label>
		<channels>
			<channel id="routeLongName" typeId="routeLongName"/>
			<channel id="routeShortName" typeId="routeShortName"/>
			<channel id="agencyName" typeId="agencyName"/>
			<channel id="routeColor" typeId="routeColor"/>
			<channel id="routeTextColor" typeId="routeTextColor"/>
			<channel id="routeNetworkName" typeId="routeNetworkName"/>
			<channel id="modeName" typeId="modeName"/>
			<channel id="vehicleName" typeId="vehicleName"/>
			<channel id="alertTitle" typeId="alertTitle"/>
			<channel id="alertDescription" typeId="alertDescription"/>
			<channel id="alertSeverity" typeId="alertSeverity"/>
			<channel id="startLocation" typeId="stopName"/>
			<channel id="destinationLocation" typeId="stopName"/>
			<channel id="activeAlertsCount" typeId="activeAlertsCount"/>
			<channel id="url" typeId="routeLongName"/>
		</channels>
	</channel-group-type>

	<channel-group-type id="tripGroup">
		<label>@text/group.tripDetails.label</label>
		<channels>
			<channel id="tripHeadsign" typeId="tripHeadsign"/>
			<channel id="tripStatus" typeId="tripStatus"/>
			<channel id="rtTripId" typeId="rtTripId"/>
			<channel id="routeLongName" typeId="routeLongName"/>
			<channel id="routeShortName" typeId="routeShortName"/>
			<channel id="routeColor" typeId="routeColor"/>
			<channel id="modeName" typeId="modeName"/>
			<channel id="vehicleName" typeId="vehicleName"/>
			<channel id="location" typeId="location"/>
			<channel id="occupancy" typeId="routeShortName"/>
			<channel id="timeToTarget" typeId="timeToTarget"/>
			<channel id="bikesAllowed" typeId="isCancelled"/>
		</channels>
	</channel-group-type>

	<channel-group-type id="stopGroup">
		<label>@text/group.upcomingStop.label</label>
		<channels>
			<channel id="stopName" typeId="stopName"/>
			<channel id="scheduledTime" typeId="departureTime"/>
			<channel id="realtimeTime" typeId="departureTime"/>
			<channel id="delayMinutes" typeId="delayMinutes"/>
			<channel id="minutesUntilDeparture" typeId="minutesUntilDeparture"/>
			<channel id="platform" typeId="platform"/>
		</channels>
	</channel-group-type>

	<channel-type id="routeLongName">
		<item-type>String</item-type>
		<label>@text/channel.routeLongName.label</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="routeShortName">
		<item-type>String</item-type>
		<label>@text/channel.routeShortName.label</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="agencyName">
		<item-type>String</item-type>
		<label>@text/channel.agencyName.label</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="tripHeadsign">
		<item-type>String</item-type>
		<label>@text/channel.tripHeadsign.label</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="tripStatus">
		<item-type>String</item-type>
		<label>@text/channel.tripStatus.label</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="departureTime">
		<item-type>DateTime</item-type>
		<label>@text/channel.departureTime.label</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="isCancelled">
		<item-type>Switch</item-type>
		<label>@text/channel.isCancelled.label</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="routeColor">
		<item-type>String</item-type>
		<label>@text/channel.routeColor.label</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="routeTextColor">
		<item-type>String</item-type>
		<label>@text/channel.routeTextColor.label</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="routeNetworkName">
		<item-type>String</item-type>
		<label>@text/channel.routeNetworkName.label</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="modeName">
		<item-type>String</item-type>
		<label>@text/channel.modeName.label</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="vehicleName">
		<item-type>String</item-type>
		<label>@text/channel.vehicleName.label</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="rtTripId">
		<item-type>String</item-type>
		<label>@text/channel.rtTripId.label</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="stopName">
		<item-type>String</item-type>
		<label>@text/channel.stopName.label</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="alertTitle">
		<item-type>String</item-type>
		<label>@text/channel.alertTitle.label</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="alertDescription">
		<item-type>String</item-type>
		<label>@text/channel.alertDescription.label</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="alertSeverity">
		<item-type>String</item-type>
		<label>@text/channel.alertSeverity.label</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="minutesUntilDeparture">
		<item-type>Number:Time</item-type>
		<label>@text/channel.minutesUntilDeparture.label</label>
		<state readOnly="true" pattern="%d %unit%"/>
	</channel-type>

	<channel-type id="delayMinutes">
		<item-type>Number:Time</item-type>
		<label>@text/channel.delayMinutes.label</label>
		<state readOnly="true" pattern="%d %unit%"/>
	</channel-type>

	<channel-type id="platform">
		<item-type>String</item-type>
		<label>@text/channel.platform.label</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="activeAlertsCount">
		<item-type>Number</item-type>
		<label>@text/channel.activeAlertsCount.label</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="location">
		<item-type>Location</item-type>
		<label>@text/channel.location.label</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="timeToTarget">
		<item-type>Number:Time</item-type>
		<label>@text/channel.timeToTarget.label</label>
		<description>@text/channel.timeToTarget.description</description>
		<state readOnly="true" pattern="%d %unit%"/>
	</channel-type>

</thing:thing-descriptions>

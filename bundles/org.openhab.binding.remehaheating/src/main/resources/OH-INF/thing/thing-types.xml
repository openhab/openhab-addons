<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="remehaheating"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<thing-type id="boiler">
		<label>Remeha Boiler</label>
		<description>Remeha Home heating system boiler</description>
		<category>heating</category>
		<semantic-equipment-tag>Boiler</semantic-equipment-tag>

		<channels>
			<channel id="room-temperature" typeId="room-temperature"/>
			<channel id="target-temperature" typeId="target-temperature"/>
			<channel id="dhw-temperature" typeId="dhw-temperature"/>
			<channel id="dhw-target" typeId="dhw-target"/>
			<channel id="dhw-mode" typeId="dhw-mode"/>
			<channel id="dhw-status" typeId="dhw-status"/>
			<channel id="water-pressure" typeId="water-pressure"/>
			<channel id="water-pressure-ok" typeId="water-pressure-ok"/>
			<channel id="outdoor-temperature" typeId="outdoor-temperature"/>
			<channel id="status" typeId="status"/>
			<channel id="thermal-mode" typeId="thermal-mode"/>
			<channel id="operating-mode" typeId="operating-mode"/>
			<channel id="seasonal-mode" typeId="seasonal-mode"/>
			<channel id="holiday-active" typeId="holiday-active"/>
			<channel id="zone-mode" typeId="zone-mode"/>
			<channel id="heating-demand" typeId="heating-demand"/>
			<channel id="next-setpoint" typeId="next-setpoint"/>
			<channel id="next-switch-time" typeId="next-switch-time"/>
			<channel id="fireplace-mode-active" typeId="fireplace-mode-active"/>
			<channel id="dhw-next-switch-time" typeId="dhw-next-switch-time"/>
			<channel id="dhw-anti-legionella" typeId="dhw-anti-legionella"/>
			<channel id="heating-curve-slope" typeId="heating-curve-slope"/>
			<channel id="heating-curve-base-setpoint" typeId="heating-curve-base-setpoint"/>
			<channel id="heating-curve-max-flow-temperature" typeId="heating-curve-max-flow-temperature"/>
		</channels>

		<properties>
			<property name="thingTypeVersion">1</property>
		</properties>

		<config-description>
			<parameter name="email" type="text" required="true">
				<context>email</context>
				<label>Email</label>
				<description>Remeha Home account email</description>
			</parameter>
			<parameter name="password" type="text" required="true">
				<context>password</context>
				<label>Password</label>
				<description>Remeha Home account password</description>
			</parameter>
			<parameter name="refreshInterval" type="integer" min="30" max="3600" unit="s">
				<label>Refresh Interval</label>
				<description>Interval to refresh data from Remeha API (from 30 to 3600 seconds)</description>
				<default>60</default>
			</parameter>
		</config-description>
	</thing-type>

	<channel-type id="room-temperature">
		<item-type unitHint="°C">Number:Temperature</item-type>
		<label>Room Temperature</label>
		<description>Current room temperature</description>
		<category>temperature</category>
		<tags>
			<tag>Measurement</tag>
			<tag>Temperature</tag>
		</tags>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="target-temperature">
		<item-type unitHint="°C">Number:Temperature</item-type>
		<label>Target Temperature</label>
		<description>Target room temperature</description>
		<category>temperature</category>
		<tags>
			<tag>Setpoint</tag>
			<tag>Temperature</tag>
		</tags>
		<state min="5" max="30" step="0.5" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="dhw-temperature">
		<item-type unitHint="°C">Number:Temperature</item-type>
		<label>Hot Water Temperature</label>
		<description>Current hot water temperature</description>
		<category>temperature</category>
		<tags>
			<tag>Measurement</tag>
			<tag>Temperature</tag>
		</tags>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="dhw-target">
		<item-type unitHint="°C">Number:Temperature</item-type>
		<label>Hot Water Target</label>
		<description>Target hot water temperature</description>
		<category>temperature</category>
		<tags>
			<tag>Setpoint</tag>
			<tag>Temperature</tag>
		</tags>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="water-pressure">
		<item-type unitHint="bar">Number:Pressure</item-type>
		<label>Water Pressure</label>
		<description>System water pressure</description>
		<category>pressure</category>
		<tags>
			<tag>Measurement</tag>
			<tag>Pressure</tag>
		</tags>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="outdoor-temperature">
		<item-type unitHint="°C">Number:Temperature</item-type>
		<label>Outdoor Temperature</label>
		<description>Outdoor temperature</description>
		<category>temperature</category>
		<tags>
			<tag>Measurement</tag>
			<tag>Temperature</tag>
		</tags>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="status">
		<item-type>String</item-type>
		<label>Status</label>
		<description>Boiler status</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="dhw-mode">
		<item-type>String</item-type>
		<label>Hot Water Mode</label>
		<description>Domestic hot water zone mode</description>
		<tags>
			<tag>Control</tag>
		</tags>
		<state>
			<options>
				<option value="anti-frost">Anti-frost</option>
				<option value="schedule">Schedule</option>
				<option value="continuous-comfort">Continuous Comfort</option>
			</options>
		</state>
	</channel-type>

	<channel-type id="dhw-status">
		<item-type>String</item-type>
		<label>Hot Water Status</label>
		<description>Hot water status</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="thermal-mode">
		<item-type>String</item-type>
		<label>Thermal Mode</label>
		<description>Active thermal mode of the appliance, e.g. heating or hot water</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="operating-mode">
		<item-type>String</item-type>
		<label>Operating Mode</label>
		<description>Operating mode of the appliance</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="seasonal-mode">
		<item-type>String</item-type>
		<label>Seasonal Mode</label>
		<description>Seasonal mode of the appliance, e.g. winter or summer</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="holiday-active">
		<item-type>Switch</item-type>
		<label>Holiday Mode Active</label>
		<description>Indicates whether the holiday schedule is currently active</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="zone-mode">
		<item-type>String</item-type>
		<label>Zone Mode</label>
		<description>Mode of the climate zone, e.g. scheduling or manual</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="heating-demand">
		<item-type>String</item-type>
		<label>Heating Demand</label>
		<description>Current comfort demand of the climate zone, e.g. whether the appliance is producing heat</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="next-setpoint">
		<item-type unitHint="°C">Number:Temperature</item-type>
		<label>Next Target Temperature</label>
		<description>Target room temperature of the next schedule switch point</description>
		<category>temperature</category>
		<tags>
			<tag>Setpoint</tag>
			<tag>Temperature</tag>
		</tags>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="next-switch-time">
		<item-type>DateTime</item-type>
		<label>Next Switch Time</label>
		<description>Time of the next schedule switch point of the climate zone</description>
		<category>time</category>
		<tags>
			<tag>Status</tag>
			<tag>Timestamp</tag>
		</tags>
		<state readOnly="true" pattern="%1$tY-%1$tm-%1$td %1$tH:%1$tM"/>
	</channel-type>

	<channel-type id="fireplace-mode-active">
		<item-type>Switch</item-type>
		<label>Fireplace Mode Active</label>
		<description>Indicates whether the fireplace mode of the climate zone is active</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="dhw-next-switch-time">
		<item-type>DateTime</item-type>
		<label>Hot Water Next Switch</label>
		<description>Time of the next schedule switch point of the hot water zone</description>
		<category>time</category>
		<tags>
			<tag>Status</tag>
			<tag>Timestamp</tag>
		</tags>
		<state readOnly="true" pattern="%1$tY-%1$tm-%1$td %1$tH:%1$tM"/>
	</channel-type>

	<channel-type id="dhw-anti-legionella">
		<item-type>Switch</item-type>
		<label>Hot Water Legionella</label>
		<description>Indicates whether the anti-legionella function of the hot water zone is enabled</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="heating-curve-slope">
		<item-type>Number</item-type>
		<label>Heating Curve Slope</label>
		<description>Slope of the heating curve of the climate zone</description>
		<state readOnly="true" min="0" max="4" step="0.1" pattern="%.1f"/>
	</channel-type>

	<channel-type id="heating-curve-base-setpoint">
		<item-type unitHint="°C">Number:Temperature</item-type>
		<label>Heating Curve Base</label>
		<description>Base setpoint of the heating curve of the climate zone</description>
		<category>temperature</category>
		<tags>
			<tag>Setpoint</tag>
			<tag>Temperature</tag>
		</tags>
		<state readOnly="true" min="15" max="60" step="0.5" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="heating-curve-max-flow-temperature">
		<item-type unitHint="°C">Number:Temperature</item-type>
		<label>Maximum Flow Temperature</label>
		<description>Maximum flow temperature of the heating curve of the climate zone</description>
		<category>temperature</category>
		<tags>
			<tag>Setpoint</tag>
			<tag>Temperature</tag>
		</tags>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="water-pressure-ok">
		<item-type>Switch</item-type>
		<label>Water Pressure OK</label>
		<description>Water pressure status</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

</thing:thing-descriptions>
